    {
      "function_name": "computeSafeTScreening",
      "description": "Run the SAFE-T safety screening for this case \u2014 returns risk tier and flags. Call BEFORE any search or booking talk. This is the Safety Gate."
    },
    {
      "function_name": "matchDoctorsForProcedure",
      "description": "Search for verified doctors for a procedure, filtered by safety tier. Returns ranked options with verification status and license expiry."
    },
    {
      "function_name": "requestDoctorQuotes",
      "description": "Notify matching doctors to clinically review the patient's case. Used in SEARCHING stage \u2014 the doctor reviews within 24 hours before any booking."
    },
    {
      "function_name": "createTravelRequest",
      "description": "Search/match travel options (flights, hotels) for the patient's destination and dates."
    },
    {
      "function_name": "assignTravelAgency",
      "description": "Assign the travel agency to coordinate flight + hotel for the case. Used in BOOKING stage after consent and doctor assignment."
    },
    {
      "function_name": "assignChauffeurServices",
      "description": "Assign ground transport (taxi) with GPS handshake pickup. Used in BOOKING stage for the 9-checkpoint handoff monitoring."
    },
    {
      "function_name": "requestCompanionPackage",
      "description": "Search for a travel companion if the safety tier or patient situation requires one."
    },
    {
      "function_name": "processInformedConsentAndEmail",
      "description": "Log the patient's explicit consent to share limited medical data with the chosen provider. Call before any booking. This is the Consent Gate."
    },
    {
      "function_name": "assignDoctorToCase",
      "description": "Book/assign the chosen doctor to the case. Call only after safety check passed AND consent logged."
    },
    {
      "function_name": "confirmProcedureDate",
      "description": "Confirm the procedure date with the assigned doctor."
    },
    {
      "function_name": "scheduleSoloCheckIns",
      "description": "Schedule proactive safety check-ins for the patient's trip (pre-trip, during travel, recovery)."
    },
    {
      "function_name": "schedulePostOpCheckIns",
      "description": "Schedule post-operative recovery check-ins."
    },
    {
      "function_name": "escalateSoloCheckIn",
      "description": "Escalate a monitored event that has deviated (missed check-in, no-show, delay) to the next safety level."
    },
    {
      "function_name": "getVisaRequirement",
      "description": "Check visa requirements for the patient's destination country."
    },
    {
      "function_name": "verifyIATACode",
      "description": "Validate an IATA code format and look it up in real time via the IATA CheckACode API. Returns is_valid, status (Valid | Code Not Listed | Format Invalid | Error), agency_name, class, country, city, approval_date. Call before any approve decision."
    },
    {
      "function_name": "checkAgencyWebsite",
      "description": "Fetch an agency's website URL to confirm it is live, capture the page title and HTTP status, and check SSL. Call during travel-agency onboarding."
    },
    {
      "function_name": "reviewTravelAgencyVerification",
      "description": "Record M-Care's final decision for a travel-agency onboarding: decision = 'approve' | 'reject' | 'escalate', with a plain-English reason. For approve, the function re-runs the IATA check itself and refuses to approve if the code is not live-verified \u2014 it escalates instead. Sends the agency an email. Returns the resulting status."
    }
  ],
  "name": "m_care"
}
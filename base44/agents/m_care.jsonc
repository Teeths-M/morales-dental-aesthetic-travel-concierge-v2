      ]
    },
    {
      "function_name": "getProcedureKnowledge",
      "description": "Fuzzy lookup into M-Care's ProcedureKnowledge safety knowledge base. Given a casual procedure name ('butt lift', 'tummy tuck', 'dental implants'), returns the best matching record(s) with full risk level, recovery time, risk factors, complication rate, common complications, recommended surgeon qualifications, pre-op requirements, red-flag combinations, smoker warning, and the questions_to_ask list \u2014 PLUS a m_care_protocol object with the exact Procedure Inquiry rules (ask medical background first, flag risks against their background, never diagnose, include the medical disclaimer, guide to a safe next step). Call this the moment a traveler mentions ANY specific procedure, BEFORE booking talk and BEFORE computeSafeTScreening. If it returns found:false, tell the traveler honestly you don't have detailed info on that procedure yet and offer to find a verified specialist \u2014 never invent risk data. Never recite procedure risk from memory; always use this tool."
    },
    {
      "function_name": "explainProcedure",
      "description": "Comprehensive, structured patient education for a specific procedure -- overview, what happens before/during/after (room time, anesthesia), recovery realities (timeline, general success range, side effects, warning signs, activity restrictions), do's and don'ts, general benefits/risks/alternatives, and questions to ask the doctor. Call this right after getProcedureKnowledge's step 0 (image + brief overview) for a full explanation. This is general, population-level education, confidence-gated and either already-curated or freshly researched -- it NEVER writes risk_level, complication_rate, red_flag_combinations, smoker_warning, or common_complications, which stay permanently admin-curated only. If the returned confidence_score is below 80, say so honestly rather than presenting the content as certain. depth and focus are optional presentation hints -- you always get the full content in one call, so a follow-up question about recovery or alternatives never needs a second call."
    },
    {
      "function_name": "computeSafeTScreening",
      "description": "Run the Safe-T4life intake screening from the patient's self-reported profile (procedure, age, BMI, conditions, medications, allergies, anesthesia history, pregnancy). Returns risk_level + flags. Call as soon as procedure + medical history are known, BEFORE any search or booking. Applies to BOTH the standard journey and Bring Your Own Journey cases. This is the Safety Gate. NEVER call for LEISURE / PROTECT-ONLY trips with no medical component."
    },
    {
      "function_name": "safeT4LifeScan",
      "description": "Run the full Safe-T4life risk engine on a confirmed CaseRecord. Takes caseId (and optional action). Returns tier CRITICAL/HIGH/MEDIUM/LOW, status BLOCKED/WAIVER_REQUIRED/PASSED, score, and flags. CRITICAL hard-locks the case; HIGH requires a waiver; MEDIUM/LOW proceed. Call once a CaseRecord exists for this patient, before booking. Treat BLOCKED as a hard stop and WAIVER_REQUIRED as a gate the patient must clear before you proceed. NEVER call for LEISURE / PROTECT-ONLY trips."
    },
    {
      "function_name": "verifyExternalJourney",
      "description": "Verify a clinic/doctor the patient booked EXTERNALLY (Bring Your Own Journey / Booked Elsewhere). Takes doctor_name, clinic_name, destination_country, destination_city, procedures, doctor_license (optional), booking_url (optional), surgery_date. Runs license registry, clinic operating status, procedure-combination RED rules, and provider intelligence. Returns overall (verified/concerns/incomplete), per-check results, recommendations, and an external_journey_id. Call when a patient says they already booked elsewhere \u2014 this is the only authority on whether their external clinic is legitimate; never claim verification the tool didn't return."
    },
    {
      "function_name": "enrollExternalJourney",
      "description": "Enroll a verified external journey into the protection layer. Requires external_journey_id + explicit disclosure_accepted: true + plan 'single_journey'. Creates an external-origin CaseRecord (protection_only) so the journey rides every protection pipeline. Call after verifyExternalJourney AND the patient's explicit acceptance of the protection-service disclosure."
    },
    {
      "function_name": "searchNearbyPlaces",
      "description": "Find nearby places for a location (police stations, pharmacies, clinics, hospitals, hotels, embassies, etc.). Use it when a traveler asks for the nearest X or needs a specific local place. Pass the real lat and lng from a LOCATION_CONTEXT block (or GPS) as the lat/lng arguments - never a free-text place name, this tool needs real coordinates. It automatically widens its search radius once if nothing turns up at first, and returns a searched_radius_km field. An empty results array is a real, honest answer - it means nothing matched within the search area, NOT that the service is down. Never say the location search isn't responding, and never silently fall back to a generic web search for something like a police station's address or phone number - say plainly that nothing was found within the search area (mention searched_radius_km if useful) and either ask for a more specific landmark or address, or offer the precise-location upgrade described in LOCATION CONTEXT. Returns place names + addresses + (often) coordinates. After returning a place, offer a {{maps:LABEL|DESTINATION}} token so the traveler can open it directly in Waze, Google Maps, or Apple Maps with one tap \u2014 never just paste a URL."
    },
    {
      "function_name": "checkWeatherAlerts",
      "description": "Check weather alerts for a destination and travel date window. Used in travel coordination (standard, BYOJ, AND leisure) to flag risks like hurricane season and recommend flexible/refundable flights + travel insurance."
    },
    {
      "function_name": "getDestinationSafetyIndex",
      "description": "Read-only destination safety index for a country/city. Use to give the traveler honest, sourced safety context for their destination (standard, BYOJ, or leisure). Never fabricate a safety rating \u2014 only state what this returns."
    },
    {
      "function_name": "generateLiveLocationRequestLink",
      "description": "Generate a secure one-time link the traveler opens to stream their live GPS to their case when they feel unsafe. Works for ALL journey types (medical, BYOJ, leisure). For a routine ride dispatch (requestOnDemandRide), call this in the SAME turn as requestOnDemandRide so the driver sees the traveler moving on the map in real time \u2014 the beacon updates the traveler's position continuously, so the driver always has their current location, not just the spot they were at when they asked."
    },
    {
      "function_name": "matchDoctorsForProcedure",
      "description": "Search for doctors for a procedure, filtered by safety tier. Every doctor this returns has already cleared Morales's full verification pipeline (license, identity, background checks, and internal admin review) \u2014 there is no partially-verified doctor this tool can return. Each result includes status/license_verified/verification_status confirming this, plus a portfolio array (the doctor's own real self-uploaded images/videos, or an empty array if they have uploaded nothing). When you name one of these doctors to the traveler, emit a {{providerstatus:approved|Name}} token for them (see the PROVIDER TRUST TIERS rule). When their portfolio array is non-empty, you may offer to show one of their real portfolio items via the {{doctormedia:DOCTOR_NAME|TYPE|URL}} token (see RULE 23) \u2014 never invent a portfolio item, and never substitute a generic procedure image in its place. NEVER call for LEISURE trips."
    },
    {
      "function_name": "requestDoctorQuotes",
      "description": "Notify matching doctors to clinically review the patient's case. Used in SEARCHING stage. NEVER call for LEISURE trips."
    },
    {
      "function_name": "createTravelRequest",
      "description": "Search/match travel options (flights, hotels) for the traveler's destination and dates. Use this in the OPTIONS stage of ALL journey types \u2014 medical, BYOJ, and leisure."
    },
    {
      "function_name": "assignTravelAgency",
      "description": "Assign the travel agency to coordinate flight + hotel for the case. Used in BOOKING stage after consent (standard journey), after enrollment (BYOJ), or after consent (leisure). Available to ALL journey types."
    },
    {
      "function_name": "assignChauffeurServices",
      "description": "Send a real quote REQUEST email to a verified taxi partner in the traveler's home country (airport transfer) and a separate verified partner in the destination country (hotel/clinic legs) - this is NOT a confirmed or dispatched ride. The partner typically responds within 24 hours; nothing is booked, confirmed, verified, or GPS-tracked until they actually reply. Never tell the traveler a specific pickup time, a driver's name, wheelchair-accessibility, or a 'verified'/'GPS-tracked' status unless the tool's own returned fields actually say so - state plainly that quote requests have been sent to a driver in each country and you will follow up once they respond. Used in BOOKING and TRIP HANDOFF for ALL journey types (standard, BYOJ, leisure)."
    },
    {
      "function_name": "requestCompanionPackage",
      "description": "Search for a travel companion if the safety tier or patient situation requires one. MEDICAL/BYOJ only \u2014 not used for leisure trips."
    },
    {
      "function_name": "processInformedConsentAndEmail",
      "description": "Log the traveler's explicit consent to share limited data with the chosen provider/partners. Call before any booking. This is the Consent Gate. For leisure trips, the shared data is logistics only (name, arrival, pickup, destination) \u2014 never medical data. Available to ALL journey types."
    },
    {
      "function_name": "confirmProcedureDate",
      "description": "Confirm the procedure date with the assigned doctor. MEDICAL/BYOJ only \u2014 never called for leisure trips."
    },
    {
      "function_name": "calculatePackagePrice",
      "description": "Compute the final package price from the confirmed partner quotas (clinic, travel, driver, companion). Call only AFTER all relevant quotas are confirmed, to show the traveler the real total. Never state a package price this tool didn't return. For leisure trips, only travel + driver quotas apply."
    },
    {
      "function_name": "generateStripePaymentLink",
      "description": "Generate a Stripe payment link for the traveler's package/deposit. Call only AFTER calculatePackagePrice returned a confirmed amount AND the traveler agreed to pay. Never invent an amount. Available to ALL journey types."
    },
    {
      "function_name": "sendClientBookingProposal",
      "description": "The click-and-pay orchestrator. Once calculatePackagePrice has returned the real package total AND the relevant partner quotas are confirmed, call this to send the client their one-tap payment link across email + SMS + WhatsApp on their behalf \u2014 the client never waits on an admin to push a proposal and gets the link wherever they prefer. It verifies the caller owns the case, refuses (409) if final_package_price is not set (>0 \u2014 call calculatePackagePrice first), generates the public /portal/proposal/:token URL, dispatches fault-tolerantly across every channel the client has, logs each to NotificationLog, and returns the payment_url + per-channel results. Present the returned payment_url in chat so the client can tap and pay immediately. Call this BEFORE sendBookingConfirmation \u2014 confirmation comes after payment. Available to ALL journey types (medical, BYOJ, leisure) once a real price exists."
    },
    {
      "function_name": "sendBookingConfirmation",
      "description": "Send the traveler their final booking confirmation summary once the full journey/trip is booked and paid. Call in the CONFIRMED stage for ALL journey types, AFTER sendClientBookingProposal has been sent and the client has paid."
    },
    {
      "function_name": "scheduleSoloCheckIns",
      "description": "Schedule proactive safety check-ins for the traveler's trip. Available to ALL journey types (medical, BYOJ, and leisure)."
    },
    {
      "function_name": "schedulePostOpCheckIns",
      "description": "Schedule post-operative recovery check-ins. MEDICAL/BYOJ only \u2014 NEVER call for LEISURE trips."
    },
    {
      "function_name": "schedulePostOpMedReminders",
      "description": "Schedule post-operative medication reminders for the patient's recovery. Call after the procedure date is confirmed. MEDICAL/BYOJ only \u2014 NEVER call for LEISURE trips."
    },
    {
      "function_name": "sendPreOpInstructions",
      "description": "Send the patient their pre-operative preparation instructions and get back the actual checklist (each item's category, text, and whether it needs doctor confirmation) \u2014 present these steps to the patient in chat, not just a 'check your email' pointer; items marked confirm_with_doctor must be framed as things their care team will confirm, never as something you are deciding. Call once the procedure date is confirmed. MEDICAL/BYOJ only \u2014 NEVER call for LEISURE trips."
    },
    {
      "function_name": "sendPostOpInstructions",
      "description": "Send the patient post-operative care instructions and get back the actual standard_care instructions and any doctor_notes \u2014 present these in chat, not just a 'check your email' pointer. Call during recovery monitoring. MEDICAL/BYOJ only \u2014 NEVER call for LEISURE trips."
    },
    {
      "function_name": "getTripReadinessTips",
      "description": "General \"how to get ready for your trip\" guidance \u2014 hydration, sleep, movement, comfort, jet lag, packing basics \u2014 plus destination-specific tips (climate, local customs) when research finds them. Available to ALL journey types, MEDICAL and LEISURE alike, unlike sendPreOpInstructions which is procedure-specific and medical-only. Call once a booking is CONFIRMED, proactively, as part of getting the traveler ready for departure. Present universal_tips as reliable, always-true guidance; present destination_tips (if returned) as researched context, and say nothing extra if destination_tips is null rather than inventing something. Never invent a flight duration or exact travel time \u2014 that data is not available here."
    },
    {
      "function_name": "escalateSoloCheckIn",
      "description": "Escalate a monitored event that has deviated to the next safety level. Available to ALL journey types."
    },
    {
      "function_name": "getVisaRequirement",
      "description": "Check visa requirements for the traveler's destination country. Available to ALL journey types where an international trip is involved."
    },
    {
      "function_name": "checkFlightStatus",
      "description": "Check a flight's live status by number or route. Use during MONITORING to anticipate delays before the traveler feels them. Never invent a status \u2014 only state what this returns. Available to ALL journey types."
    },
    {
      "function_name": "handleFlightDisruption",
      "description": "Act on a flight delay/cancellation detected during monitoring: rebooks/reroutes using real tools and notifies the traveler calmly. Call when checkFlightStatus or a disruption signal reports a real problem. The traveler never feels the panic \u2014 you absorb it. Available to ALL journey types."
    },
    {
      "function_name": "triggerSOS",
      "description": "Trigger an SOS emergency response for the traveler. Call ONLY in a genuine, traveler-confirmed emergency \u2014 never speculatively. Tell the traveler plainly what you did. Available to ALL journey types."
    },
    {
      "function_name": "activateEmergencyBeacon",
      "description": "Activate the traveler's emergency beacon to begin urgent monitoring. Call only in a confirmed safety emergency alongside the SOS path. Available to ALL journey types."
    },
    {
      "function_name": "requestEmergencyRecoveryTransport",
      "description": "Request emergency recovery transport for a traveler in distress. Call only when a monitored event has escalated to a real emergency. Available to ALL journey types."
    },
    {
      "function_name": "requestOnDemandRide",
      "description": "Real-time, on-demand ride dispatch for a normal authenticated traveler with an active case - not gated on a confirmed emergency (unlike requestEmergencyRecoveryTransport/triggerSOS) and not the async quote-request flow (unlike assignChauffeurServices, which can take up to 24h). Call for a routine \"get me a cab\" / \"I need a ride now\" / \"can you send a driver\" / \"get me a ride\" request. DISPATCH PROTOCOL (follow exactly, in this order): (1) USE THE LOCATION_CONTEXT COORDINATES IMMEDIATELY - if the conversation already has a LOCATION_CONTEXT block (lat/lng), pass those coordinates straight into this tool as pickup_latitude/pickup_longitude and pickup_location_source. Do NOT ask \"where are you?\" - the system already has the location. Do NOT ask the traveler to confirm it first. The one exception: if no LOCATION_CONTEXT block exists at all in this conversation, ask one short question for their current location and then dispatch. (2) CALL generateLiveLocationRequestLink IN THE SAME TURN - issue both tool calls together (parallel, not sequential) so a live GPS beacon is active the moment the ride is dispatched; the driver must be able to see the traveler moving on the map in real time, not just the spot they were at when they asked. Pass the case_id if known and a short reason like \"Routine ride dispatch - live tracking for driver pickup\". (3) NARRATE THE FULL BREAKDOWN IN ONE REPLY - after both calls return, reply with short labeled lines (not a wall of text), matching the concierge voice: a line for the driver status (\u2705 Driver contacted \u2014 [driver_name from the result, or 'a verified driver from our network' if driver_assigned is true but no name, or 'No driver available right now' if driver_assigned is false]), a line for the visual safety code displayed prominently (\ud83d\udd10 Your safety code: MANGO-7421 \u2014 the driver will say this code before they approach you), a line confirming the driver was contacted by SMS with the pickup location (\ud83d\udccd SMS sent with your pickup location), a line confirming live location sharing is on so the driver sees the traveler moving on the map (\ud83d\udce1 Live location is on \u2014 your driver sees you moving on the map), and one calm closing line: 'Hold tight. You are covered.' Offer the {{maps:LABEL|DESTINATION}} token for the pickup point as the last line so the traveler can share it or see it themselves. (4) NO-DRIVER PATH - if the result returns driver_assigned: false, STILL call generateLiveLocationRequestLink (the beacon stays on so a manually-assigned driver can find them), give the honest no-driver message ('No driver is available right now \u2014 I've flagged this for the team to arrange one manually'), give the visual code anyway (it applies the moment a driver is manually assigned), explain the live beacon is on so the team has their current position, and offer the SOS option as a next step via the choices token: {{choices:\ud83c\udd98 Send SOS now|I'll wait}}. Never invent a driver name, ETA, or confirmation number the tool did not return. Narrate only the real returned driver_assigned/visual_code/driver_name/status. Available to ALL journey types."
    },
    {
      "function_name": "notifyGuardianNow",
      "description": "Send an immediate alert to the traveler's already-configured guardian with their current location - additive to the routine check-in ladder, for when the traveler wants their guardian to know right now. If no guardian link exists yet (needs_consent:true in the response), offer generateGuardianLink instead - never silently substitute one for the other. is_confirmed_emergency must only be set true when the traveler has explicitly confirmed they need help (e.g. after a distress welfare-check), never speculatively. Available to ALL journey types."
    },
    {
      "function_name": "dispatchSoloSecurity",
      "description": "Dispatch a verified security agency to a solo traveler whose check-in has escalated. Call only via the escalation path (after escalateSoloCheckIn), never speculatively. Available to ALL journey types."
    },
    {
      "function_name": "handleCrisisReroute",
      "description": "The coordination-loop orchestrator. Call the moment anything breaks on a BOOKED journey \u2014 a provider cancels < 24h before the procedure, a flight is cancelled/delayed > 4h, a driver no-shows > 15 min, a companion flags patient distress, or a provider's credentials expire mid-trip. Pass case_id, crisis_type (PROVIDER_CANCELLED | FLIGHT_CANCELLED | DRIVER_NO_SHOW | COMPANION_DISTRESS | PROVIDER_CREDENTIAL_EXPIRED | EMERGENCY), detected_by (AI | PATIENT_REPORT | PROVIDER_MESSAGE | EXTERNAL_API), source_message (the incoming text/signal), and the original provider details if known. It looks up the matching BookingFallbackRule, executes the fallback action (auto-reassigns a verified backup doctor, dispatches a backup driver, or reroutes the flight via the existing handlers), sends the patient ONE calm 'I've already handled it' message across SMS + email, notifies every stakeholder (driver, travel agency, companion, admin), and writes a permanent CrisisReroute audit record with resolution time. Surface the returned patient_message verbatim in the chat \u2014 that is the reassurance. Returns human_escalated:true when a human must take over (no backup available, or the rule mandates it). NEVER say 'Let me look into that' when something breaks \u2014 call this first, then narrate. Available to ALL journey types once a booking exists."
    },
    {
      "function_name": "getRecoveryNutritionPlan",
      "description": "M-Care's recovery nutrition engine. Given a case_id (preferred \u2014 pulls procedure, procedure date, allergies, dietary restrictions, and culture from the case + consultation) OR explicit procedure_category + recovery_phase + allergies[] + dietary_restrictions[] + culture, returns the matching ProcedureDietaryProtocol for the current recovery phase, with recommended_foods FILTERED to remove anything clashing with the patient's allergies and dietary restrictions (nut allergy removes nuts; halal removes non-halal; vegetarian removes meat; vegan removes all animal products), foods_to_avoid with severity, hydration_protocol, supplement_recommendations, cultural_adaptations matched to the patient's culture, a derived shopping list, and safety notes. Computes the current recovery phase from the procedure_date when a case_id is given. Call it at the start of recovery and on each phase transition; present the plan as a caring, allergy-safe, culturally-adaptive nutritionist would (shopping list grouped by category, what to avoid and why, hydration, supplements). Always include the medical disclaimer: M-Care is not a dietitian; consult the patient's clinician before changing diet. Never invent nutrition data \u2014 only what the protocol returns; if found:false, give general hydration + protein guidance and flag that the clinician should specify the plan."
    },
    {
      "function_name": "getConciergeRecommendations",
      "description": "M-Care's proactive downtime concierge. Call during MONITORING/RECOVERY (medical) or downtime (leisure) to suggest recovery-friendly restaurants, gentle activities, and low-effort cultural experiences near the clinic/hotel, tailored to the patient's procedure and dietary needs. Pass case_id and an optional category (restaurant | activity | experience | mixed). It reads the case (clinic/hotel coords, procedure, consultation dietary profile) and uses live web context to return 5-7 real, named places with address + why it's recovery-friendly + a practical note. Surface each suggestion with a {{maps:LABEL|DESTINATION}} token using the returned address. Never invent a place \u2014 only what the tool returns. Available to ALL journey types."
    },
    {
      "function_name": "manageMedicalTravelGroup",
      "description": "Coordinate a medical-tourism group \u2014 multiple patients traveling together for the same procedure at the same destination. action 'create' (leader): pass group_name, group_leader_email, group_leader_name, procedure, destination_country, destination_city, travel_start_date, travel_end_date, member_emails[], member_names[], member_case_ids[], notes. Returns group_id. action 'join' (member): pass group_id, member_email, member_name, case_id. Adds the member. Each member keeps their own CaseRecord + own Safe-T screening \u2014 group coordination never bypasses individual safety. Shared logistics (same travel agency, driver pool, clinic window) get layered on top. Available to MEDICAL/BYOJ journey types."
    },
    {
      "function_name": "manageVerifiedCredential",
      "description": "Immutable, hash-chained credential storage \u2014 'upload once, verify immutably'. action 'mint': call the moment a real verification tool approves a partner credential (runDoctorVerificationScan 'approved' for a doctor's license, verifyIATACode valid for a travel agency's IATA code, document-intelligence authentic for insurance/accreditation, admin_manual). Pass partner_type, partner_id, partner_name, credential_type (license|iata_code|insurance|accreditation|identity|business_registration|other), credential_reference (the license/IATA number), file_url (if vaulted), verified_by (the tool or 'admin_manual'), verification_source (registry|document_intelligence|admin_manual|iata_api|background_check), expires_at. It computes a SHA-256 credential_hash and links it to the partner's previous credential hash (GENESIS for the first), storing an immutable record. action 'verify_chain': pass partner_id to re-walk that partner's credential chain, recompute every hash, and report any break/tamper. Never mint before the real approval; never claim a credential is immutable/verified unless this tool returned it."
    },
    {
      "function_name": "detectPaymentDiscrepancies",
      "description": "Automated payment-discrepancy detector. Reminders + receipts already run automatically; this closes the gap by flagging underpaid (Paid In Full but amount_paid < final_package_price), overpaid, math mismatch (amount_remaining != final_package_price - amount_paid), and receipt-missing cases. Call it when a patient asks about their payment status or when you suspect a mismatch \u2014 it scans recent cases, flags discrepancies, and emails the admin a summary. Tell the patient plainly what it found (or that everything reconciles). Never fabricate a payment status this tool didn't return."
    },
    {
      "function_name": "generateGuardianLink",
      "description": "The Family Portal. Generate a zero-login guardian link so family at home can follow the traveler's journey (status, timeline, updates) and respond via guardianCheckIn/guardianEscalation. Call only with the traveler's explicit consent. Available to ALL journey types."
    },
    {
      "function_name": "manageTripPause",
      "description": "Pause or resume a traveler's trip monitoring (e.g. during a medical procedure so check-ins don't fire mid-surgery, or during a long-haul flight). Call only with an explicit reason and resume promptly afterward. Available to ALL journey types."
    },
    {
      "function_name": "sendGoldenMNotification",
      "description": "Issue the Golden M completion recognition when a traveler safely completes their journey and returns home. Call at trip completion for ALL journey types (standard, Bring Your Own Journey, and leisure)."
    },
    {
      "function_name": "mcareCreateTravelAgencyPending",
      "description": "The ONLY way to create a new TravelAgency record. Creates it as pending_verification and starts the real verification pipeline \u2014 you never write to the TravelAgency entity directly. Call this first, before verifyIATACode."
    },
    {
      "function_name": "mcareCreateTaxiServicePending",
      "description": "The ONLY way to create a new TaxiService record. Creates it as pending_verification and starts the real verification pipeline \u2014 you never write to the TaxiService entity directly. Call this first, before anything else in the TAXI flow."
    },
    {
      "function_name": "mcareCreateCompanionPending",
      "description": "The ONLY way to create a new Companion record. Creates it as pending_verification and starts the real verification pipeline \u2014 you never write to the Companion entity directly. Call this first, before anything else in the COMPANION flow."
    },
    {
      "function_name": "mcareCreateSecurityAgencyPending",
      "description": "The ONLY way to create a new SecurityAgency record. Creates it as pending_verification and starts the real verification pipeline \u2014 you never write to the SecurityAgency entity directly. Call this first, before anything else in the SECURITY AGENCY flow."
    },
    {
      "function_name": "flagIntakeHandoff",
      "description": "Hand this conversation to a human care-team member with full context so the patient never has to repeat themselves. Call this the moment someone directly asks for a human, or when you are genuinely uncertain about something consequential rather than guessing."
    },
    {
      "function_name": "validateProcedureSafety",
      "description": "Checks a real combination of procedures against Morales' deterministic safety-compatibility engine (the same check that runs again automatically before any booking is finalized) - given items (procedure name strings) and conditions (disclosed medical conditions), returns isBlocked, violations, and a real reason string when blocked (examples: 3+ major surgeries together, over 8 combined anesthesia hours, or a named dangerous pairing). Call this once the traveler has mentioned 2 or more procedures for the same trip. Never invent a stacking concern yourself - only state what this tool actually returned, and always frame it as an early heads-up: the real deterministic check still runs again, independently, at actual booking time regardless of what you say here."
    },
    {
      "function_name": "checkRepeatProcedureHistory",
      "description": "A different check from validateProcedureSafety - this one looks ACROSS the patient's own past trips, not within one booking. Given procedures (the procedure name(s) they are asking about), checks their real, doctor-confirmed history through Morales for how many times they have already had the SAME procedure done. Returns requiresReview: true once a real repeat is found (this booking would be their 3rd+ time). requiresReview: true means it gets flagged for mandatory doctor review and a signed waiver - never an automatic block and never a refusal; a doctor reviews it and it can still move forward once they sign off. Never claim a repeat is flagged unless this tool actually returned requiresReview: true."
    },
    {
      "function_name": "verifyIATACode",
      "description": "Validate an IATA code format and look it up in real time via the IATA CheckACode API. Call before any travel-agency approve decision."
    },
    {
      "function_name": "checkAgencyWebsite",
      "description": "Fetch an agency's website URL to confirm it is live, capture the page title and HTTP status, and check SSL."
    },
    {
      "function_name": "reviewTravelAgencyVerification",
      "description": "Record M-Care's final decision for a travel-agency onboarding (approve/reject/escalate). Re-runs the IATA check on approve and refuses if not live-verified. Sends the agency an email."
    },
    {
      "function_name": "initiatePartnerVerification",
      "description": "Start the verification pipeline for ANY non-doctor partner type (taxi, companion, security). Call right after creating the pending partner record."
    },
    {
      "function_name": "generateChauffeurPortalLink",
      "description": "Generate the taxi-partner dashboard/portal link to deliver once taxi verification completes."
    },
    {
      "function_name": "getTaxiDriverCases",
      "description": "Fetch active trips/cases for a taxi partner or driver during handoff and recovery."
    },
    {
      "function_name": "sendDriverAlert",
      "description": "Send the driver a structured trip detail message (pickup, destination, traveler identifier, secure app link) via SMS."
    },
    {
      "function_name": "cancelDriverAssignment",
      "description": "Cancel the original driver's assignment so a backup can take over."
    },
    {
      "function_name": "escalateMissedDriverHandshake",
      "description": "Detect a missed GPS handshake check-in and auto-scan for a backup driver."
    },
    {
      "function_name": "reviewTaxiServiceVerification",
      "description": "Admin/human review action that sets a taxi partner's license/insurance verified. M-Care references the resulting verification_status to know when a taxi partner is truly verified."
    },
    {
      "function_name": "mcareCreateDoctorPending",
      "description": "The ONLY way to create a new Doctor record. Creates it as pending_verification \u2014 you never write to the Doctor entity directly. Call this first, before runDoctorVerificationScan."
    },
    {
      "function_name": "runDoctorVerificationScan",
      "description": "Run the full multi-layer doctor onboarding verification scan: internet/website presence, license registry, identity/passport, device+network intelligence, and background/sanctions \u2014 returns a confidence score (0-100), a decision (approved | flagged_for_admin_review), per-layer results, flags, and an audit step list. Call after creating the pending Doctor record with the doctor's website, license, and uploaded ID. Never claim a doctor is verified before this returns 'approved'."
    },
    {
      "function_name": "generateDoctorPortalLink",
      "description": "Generate the doctor's provider dashboard/portal link to deliver once their verification scan is approved."
    },
    {
      "function_name": "analyzeDocumentIntelligence",
      "description": "Forensic analysis of ANY document a partner uploads (license, IATA certificate, insurance, passport/ID, medical credential, business registration) as a chat file attachment or via the secure vault. Pass file_url plus the claimed values you already collected (partner_type, partner_id, claimed_iata_code, claimed_business_name, claimed_license_number, claimed_country, document_type_hint). It OCRs the doc, classifies it, extracts every code/name/date, assesses authenticity (authentic / likely_authentic / suspicious / likely_forged / indeterminate), detects forgery/anomaly signals, expiry, cross-checks extracted values vs what the partner claimed, and writes any HIGH/CRITICAL mismatch or forgery signal to the shared FraudIndicator table. Narrate the result using EXACTLY the tool output \u2014 never invent a finding. If authenticity is suspicious/likely_forged, OR any claimed value mismatches the document, OR the document is expired, do NOT approve \u2014 present the concern and escalate to admin review; for expiry, ask for a current document before proceeding."
    },
    {
      "function_name": "crossCheckFraudIndicators",
      "description": "Cross-match a partner's identifiers (emails[], phones[], domains[], names[]) against the shared FraudIndicator table and the confirmed FraudBlacklist BEFORE approving onboarding. Returns risk_level (critical | high | medium | low), matched_indicators, and a recommendation. critical/high = do NOT approve \u2014 tell the partner a verification concern was flagged and a human reviewer will follow up within 24h (never reveal the specific indicator or its source to the partner). medium = continue onboarding but flag for review. low = proceed normally. Call during every partner onboarding, right after you have the partner's contact details and before any approval decision."
    },
    {
      "function_name": "logMcarePerformance",
      "description": "Fire-and-forget analytics log for M-Care stage transitions and outcome checkpoints. Call on every journey stage advance (stage_from -> stage_to) and on key outcomes (safety gate result, consent logged, booking confirmed, monitoring scheduled, Golden M issued). Pass conversation_id, case_id (if known), stage_from, stage_to, journeyType (MEDICAL | BYOJ | LEISURE_PROTECT_ONLY), partner_type (for onboarding), outcome, and short notes. Never block the conversation on this call \u2014 it is analytics-only and best-effort; a failure here does not affect the traveler's journey."
    },
    {
      "function_name": "recallMcareKnowledge",
      "description": "Look up a question in McareKnowledge, M-Care's research-and-learn cache. Returns the best matching previously-researched answer(s) (saved at >=80% confidence, with its source and a freshness check) so you can answer instantly instead of re-researching. Each match carries verification_status (never 'verified' - only researched/corroborated/stale/conflicted) and is_fresh. Call this FIRST whenever a traveler/partner asks a factual question you're unsure of. If it returns found:false, no strong match, or the top match is stale or conflicted, call mcareResearchAndLearn to get or re-check a current answer. Never diagnose or prescribe through this path. See RULE 35 for how to talk about a recalled answer honestly."
    },
    {
      "function_name": "mcareResearchAndLearn",
      "description": "Research a question M-Care is stuck on, or re-check one that recallMcareKnowledge returned as stale or conflicted, and - if the answer is rated at least 80% confidence - save it to McareKnowledge with its real source for reuse next time. Uses live web context (non-diagnostic, factual answers only). Returns the answer plus its real verification_status, freshness_tier, is_fresh, source_url, source_type, and last_verified_at, and whether this was a fresh save, a confirmed revalidation, or a detected conflict (conflict_detected:true - never present either side as certain when this is true). Call this when recallMcareKnowledge found no strong match, or to force a fresh check on something stale. Tell the traveler plainly whether you're confident; if confidence is below 80%, don't present it as certain and offer to escalate to the care team. See RULE 35 for the exact honest phrasing to use."
    },
    {
      "function_name": "discoverProviderCandidates",
      "description": "Searches the open web (via Tavily) for a provider Morales doesn't already have in its network \u2014 for example a specialist in a specific city or region. Checks Morales's own existing Doctor records FIRST, then searches the web only for what's still missing. Returns known_providers (already in the Morales network, tell the traveler these are real Morales partners) and candidates (found on the web) SEPARATELY. A candidate is NEVER verified, no matter how high its identity_confidence is \u2014 always tell the traveler plainly that a web-discovered provider still needs a human to check their credentials before Morales would ever book with them or share the traveler's information with them. If discovery_available is false, say so honestly (Tavily isn't configured yet) rather than implying you searched the web when you didn't \u2014 known_providers may still be useful even then. When you name a candidate to the traveler, emit a {{providerstatus:discovered|Name}} token for them (see the PROVIDER TRUST TIERS rule) \u2014 never {{providerstatus:approved|Name}}, and never {{providerstatus:verified|Name}} unless verifyDiscoveredCandidate has actually run for that candidate and returned eligible_for_verified_badge:true. identity_confidence alone, no matter how high, is never enough on its own."
    },
    {
      "function_name": "verifyDiscoveredCandidate",
      "description": "Runs a REAL government-registry check (US, Colombia, or Mexico only) against a candidate discoverProviderCandidates already found, once a license number exists \u2014 call with candidate_id and license_number. discoverProviderCandidates alone can never verify anything, since a raw search result essentially never contains a license number; this is the honest completion step for when one becomes available (the traveler supplies it, a human reviewer supplies it, or you spotted one in the candidate's own search snippet). Never creates or updates a real Doctor/TravelAgency/etc. record and never promotes the candidate \u2014 a passed check is real evidence for a human reviewer, not a Morales approval. Use the response's eligible_for_verified_badge field, and only that field, to decide whether {{providerstatus:verified|Name}} is honest for this candidate (see the PROVIDER TRUST TIERS rule) \u2014 report the real outcome plainly either way, including a not-found or low-confidence result."
    },
    {
      "function_name": "researchPartnerWebsite",
      "description": "Checks the real, on-file website of a Morales partner (doctor or travel agency only -- taxi drivers, companions, and security agencies have no website field on file) -- fetches the page and extracts any email, phone, WhatsApp link, or address it can find, and flags plainly if that differs from the contact info Morales already has on file. Pass partner_type and partner_id. This is text-based research, not a screenshot or a browser -- if a site is heavily JavaScript-rendered, say so honestly rather than reporting a false 'no contact info found'. This ONLY works for a partner already onboarded to Morales -- it can never look up or contact a business Morales has no record for."
    },
    {
      "function_name": "draftPartnerOutreach",
      "description": "Drafts a message to an already-onboarded Morales partner (doctor, travel agency, driver, companion, or security agency) on the traveler's behalf, using the real case context and, if available, real research from their own website. Pass case_id, partner_type, partner_id, and a short intent describing what the message should say. This writes and sends NOTHING by itself -- it only returns a draft, which renders as an interactive card the traveler must explicitly review, optionally edit, and tap Send before anything actually goes out. Never tell the traveler a message has been sent just because you called this tool -- only the traveler's own tap on the card sends it, and you will only know it was sent if they tell you afterward or a later message confirms it."
    },
    {
      "function_name": "reportMedication",
      "description": "Call this the moment a patient tells you about a medication they're taking, in their own words -- pass case_id and the raw text of what they said. This normalizes it, checks it against their on-file allergies and existing medications for real reconciliation flags (duplicates, a possible allergy-name match, missing dosage/frequency, low-confidence extraction), and creates an unverified record the patient must still confirm before it counts as active. Never treat this call as confirming, prescribing, starting, stopping, or changing a medication yourself -- it only ever creates something for a real human to confirm."
    },
    {
      "entity_name": "Medication",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "function_name": "openMcareScanner",
      "description": "Opens the M-Care Scanner inline in the chat so the traveler can capture or upload a document (camera or file/PDF, multi-page). Call this the moment someone indicates they need to provide, upload, or scan a specific document (passport, license, medical record, insurance, visa, etc.) \u2014 pass a short hint_text of what they said so the scanner can pre-fill a best guess at the document type. This tool only opens the interactive scanner card and resolves who is asking; it never sees or touches a file itself \u2014 the real OCR, classification, quality check, and verification happen inside the card, in scanVaultDocument, from the actual captured image. Say plainly that you are opening the scanner (e.g. Let me open your M-Care Scanner), then let the card do the rest \u2014 do not narrate steps the card is already showing."
    },
    {
      "function_name": "postCaseMessage",
      "description": "Post a message into the Care Room thread (QuoteMessage entity) on behalf of the patient, the doctor, or M-Care itself. This is the live 3-way chat channel between patient, doctor, and M-Care. Pass case_id, quote_id (optional, omit for the case-wide Care Room thread), body (the message text), and message_type ('message' | 'info_request' | 'answer'). The message is stored with from_party set to whoever the caller is, and is visible to all parties in the thread. M-Care uses message_type 'message' with from_party 'm_care' to post system announcements (gold-tinted bubbles). Contact details are scrubbed pre-booking. This is how the live Care Room chat flows between patient and doctor after the doctor confirms."
    },
    {
      "entity_name": "VaultDocument",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "JourneyEvent",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "function_name": "createJourneyPlan",
      "description": "Real, gated creation of a JourneyPlan -- call this for a genuinely multi-step request to lay out an explicit, ordered list of real steps you intend to take, per RULE 32. Every step starts pending; you never set a step's status here, only updateJourneyPlanStep does that later."
    },
    {
      "function_name": "updateJourneyPlanStep",
      "description": "The only way to mark real progress on a JourneyPlan step -- call this only once a step has actually happened (a real tool call succeeded, or the traveler confirmed it), never pre-emptively. A step that genuinely fails should be marked failed with honest notes, per RULE 32."
    },
    {
      "entity_name": "JourneyPlan",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "function_name": "getTravelBriefing",
      "description": "Pulls together a full travel-logistics briefing for a destination: real weather, Morales's own destination safety index, recent notable events researched live, general trip-readiness tips, and (when a nationality is given) the real visa/entry requirement, all in one call. Call this the moment a traveler expresses real trip-planning intent for a specific destination, per RULE 36. Flights are included only when an origin is known, and this is honest if live flight search is not connected yet."
    },
    {
      "function_name": "searchFlights",
      "description": "Search for flight options between two cities/airports (direct, one-stop, two-stop). Honestly reports that live flight search is not connected yet until a real flight-data API key is configured \u2014 never invents a flight number, schedule, or price. Use for a narrower flight-only follow-up; getTravelBriefing already includes this for a first full briefing."
    },
    {
      "function_name": "checkCaseRequirements",
      "description": "Deterministic check of what a case still needs \u2014 reads the real case file (passport document + validity, visa status + document, data-processing consent, medical-history-share consent) and reports plainly what is present, what is missing, and what needs attention. No LLM, no invented items \u2014 only ever reports the real check. Use this per RULE 37 instead of guessing what a traveler still needs to provide."
    },
    {
      "entity_name": "AgentRun",
      "allowed_operations": ["read"]
    },
    {
      "function_name": "logAgentRun",
      "description": "Call once after a genuinely multi-step autonomous pass actually completes (RULE 38). Records what you really checked, found, proposed, took, or held back pending approval, and the real outcome, as a persistent AgentRun a traveler can later ask about. Never call this with a fabricated record or finding -- an honest, partial summary is always correct, an inflated one never is."
    },
    {
      "function_name": "getPassportValidityRequirement",
      "description": "Real, destination-aware check of the minimum passport validity required for a specific nationality entering a specific country -- never the generic 6-month guideline checkCaseRequirements already states honestly on its own. Confidence-gated: returns a confirmed answer with a real source when confident, or status unverified plus a real confirmation task for the care team when it is not. Never invents a per-country rule."
    },
    {
      "function_name": "getCaseRiskSummary",
      "description": "Deterministic Risk Engine -- combines real signals already checked elsewhere (document readiness, visa status, SAFE-T and MedGuard results, consent, payment, companion needs) into one Critical / Needs attention / Monitor / Cleared severity view per RULE 37, each item with why it matters, real evidence, an owner, and a next step. No LLM call -- only ever reports what the underlying real checks already found."
    },
    {
      "function_name": "getEvidenceWatchFeed",
      "description": "Returns human-reviewed, admin-approved Medical Evidence Watch findings (new treatments, trials, device approvals, recalls, safety alerts) relevant to medical travel -- real title, evidence stage, plain-language summary, and sources for each. Read-only, no filters. Use per RULE 40: only mention a genuine match to what is being discussed, never invent detail beyond what this returns, and never claim more certainty than the item's own confidence label."
    }
  ],

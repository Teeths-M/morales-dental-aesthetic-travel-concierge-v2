    {
      "entity_name": "VerifiedCredential",
      "allowed_operations": [
        "read",
        "create"
      ]
    },
    {
      "function_name": "getProcedureKnowledge",
      "description": "Fuzzy lookup into M-Care's ProcedureKnowledge safety knowledge base. Given a casual procedure name ('butt lift', 'tummy tuck', 'dental implants'), returns the best matching record(s) with full risk level, recovery time, risk factors, complication rate, common complications, recommended surgeon qualifications, pre-op requirements, red-flag combinations, smoker warning, and the questions_to_ask list — PLUS a m_care_protocol object with the exact Procedure Inquiry rules (ask medical background first, flag risks against their background, never diagnose, include the medical disclaimer, guide to a safe next step). Call this the moment a traveler mentions ANY specific procedure, BEFORE booking talk and BEFORE computeSafeTScreening. If it returns found:false, tell the traveler honestly you don't have detailed info on that procedure yet and offer to find a verified specialist — never invent risk data. Never recite procedure risk from memory; always use this tool."
    },
    {
      "function_name": "computeSafeTScreening",
      "description": "Run the Safe-T4life intake screening from the patient's self-reported profile (procedure, age, BMI, conditions, medications, allergies, anesthesia history, pregnancy). Returns risk_level + flags. Call as soon as procedure + medical history are known, BEFORE any search or booking. Applies to BOTH the standard journey and Bring Your Own Journey cases. This is the Safety Gate. NEVER call for LEISURE / PROTECT-ONLY trips with no medical component."
    },
    {
      "function_name": "safeT4LifeScan",
      "description": "Run the full Safe-T4life risk engine on a confirmed CaseRecord. Takes caseId (and optional action). Returns tier CRITICAL/HIGH/MEDIUM/LOW, status BLOCKED/WAIVER_REQUIRED/PASSED, score, and flags. CRITICAL hard-locks the case; HIGH requires a waiver; MEDIUM/LOW proceed. Call once a CaseRecord exists for this patient, before booking. Treat BLOCKED as a hard stop and WAIVER_REQUIRED as a gate the patient must clear before you proceed. NEVER call for LEISURE / PROTECT-ONLY trips."
    },
    {
      "function_name": "verifyExternalJourney",
      "description": "Verify a clinic/doctor the patient booked EXTERNALLY (Bring Your Own Journey / Booked Elsewhere). Takes doctor_name, clinic_name, destination_country, destination_city, procedures, doctor_license (optional), booking_url (optional), surgery_date. Runs license registry, clinic operating status, procedure-combination RED rules, and provider intelligence. Returns overall (verified/concerns/incomplete), per-check results, recommendations, and an external_journey_id. Call when a patient says they already booked elsewhere — this is the only authority on whether their external clinic is legitimate; never claim verification the tool didn't return."
    },
    {
      "function_name": "enrollExternalJourney",
      "description": "Enroll a verified external journey into the protection layer. Requires external_journey_id + explicit disclosure_accepted: true + plan 'single_journey'. Creates an external-origin CaseRecord (protection_only) so the journey rides every protection pipeline. Call after verifyExternalJourney AND the patient's explicit acceptance of the protection-service disclosure."
    },
    {
      "function_name": "searchNearbyPlaces",
      "description": "Find nearby places for a location (police stations, pharmacies, clinics, hospitals, hotels, embassies, etc.). Use it when a traveler asks for the nearest X or needs a specific local place. Returns place names + addresses + (often) coordinates. After returning a place, offer a {{maps:LABEL|DESTINATION}} token so the traveler can open it directly in Waze, Google Maps, or Apple Maps with one tap — never just paste a URL."
    },
    {
      "function_name": "checkWeatherAlerts",
      "description": "Check weather alerts for a destination and travel date window. Used in travel coordination (standard, BYOJ, AND leisure) to flag risks like hurricane season and recommend flexible/refundable flights + travel insurance."
    },
    {
      "function_name": "getDestinationSafetyIndex",
      "description": "Read-only destination safety index for a country/city. Use to give the traveler honest, sourced safety context for their destination (standard, BYOJ, or leisure). Never fabricate a safety rating — only state what this returns."
    },
    {
      "function_name": "generateLiveLocationRequestLink",
      "description": "Generate a secure one-time link the traveler opens to stream their live GPS to their case when they feel unsafe. Works for ALL journey types (medical, BYOJ, leisure)."
    },
    {
      "function_name": "matchDoctorsForProcedure",
      "description": "Search for verified doctors for a procedure, filtered by safety tier. Returns ranked options with verification status and license expiry. NEVER call for LEISURE trips."
    },
    {
      "function_name": "requestDoctorQuotes",
      "description": "Notify matching doctors to clinically review the patient's case. Used in SEARCHING stage. NEVER call for LEISURE trips."
    },
    {
      "function_name": "createTravelRequest",
      "description": "Search/match travel options (flights, hotels) for the traveler's destination and dates. Use this in the OPTIONS stage of ALL journey types — medical, BYOJ, and leisure."
    },
    {
      "function_name": "assignTravelAgency",
      "description": "Assign the travel agency to coordinate flight + hotel for the case. Used in BOOKING stage after consent (standard journey), after enrollment (BYOJ), or after consent (leisure). Available to ALL journey types."
    },
    {
      "function_name": "assignChauffeurServices",
      "description": "Match a verified+available taxi partner and send them a structured trip request. Used in BOOKING and TRIP HANDOFF for ALL journey types (standard, BYOJ, leisure)."
    },
    {
      "function_name": "requestCompanionPackage",
      "description": "Search for a travel companion if the safety tier or patient situation requires one. MEDICAL/BYOJ only — not used for leisure trips."
    },
    {
      "function_name": "processInformedConsentAndEmail",
      "description": "Log the traveler's explicit consent to share limited data with the chosen provider/partners. Call before any booking. This is the Consent Gate. For leisure trips, the shared data is logistics only (name, arrival, pickup, destination) — never medical data. Available to ALL journey types."
    },
    {
      "function_name": "assignDoctorToCase",
      "description": "Book/assign the chosen doctor to the case. Call only after safety check passed AND consent logged. NEVER call for LEISURE trips."
    },
    {
      "function_name": "confirmProcedureDate",
      "description": "Confirm the procedure date with the assigned doctor. MEDICAL/BYOJ only — never called for leisure trips."
    },
    {
      "function_name": "calculatePackagePrice",
      "description": "Compute the final package price from the confirmed partner quotas (clinic, travel, driver, companion). Call only AFTER all relevant quotas are confirmed, to show the traveler the real total. Never state a package price this tool didn't return. For leisure trips, only travel + driver quotas apply."
    },
    {
      "function_name": "generateStripePaymentLink",
      "description": "Generate a Stripe payment link for the traveler's package/deposit. Call only AFTER calculatePackagePrice returned a confirmed amount AND the traveler agreed to pay. Never invent an amount. Available to ALL journey types."
    },
    {
      "function_name": "sendClientBookingProposal",
      "description": "The click-and-pay orchestrator. Once calculatePackagePrice has returned the real package total AND the relevant partner quotas are confirmed, call this to send the client their one-tap payment link across email + SMS + WhatsApp on their behalf — the client never waits on an admin to push a proposal and gets the link wherever they prefer. It verifies the caller owns the case, refuses (409) if final_package_price is not set (>0 — call calculatePackagePrice first), generates the public /portal/proposal/:token URL, dispatches fault-tolerantly across every channel the client has, logs each to NotificationLog, and returns the payment_url + per-channel results. Present the returned payment_url in chat so the client can tap and pay immediately. Call this BEFORE sendBookingConfirmation — confirmation comes after payment. Available to ALL journey types (medical, BYOJ, leisure) once a real price exists."
    },
    {
      "function_name": "sendBookingConfirmation",
      "description": "Send the traveler their final booking confirmation summary once the full journey/trip is booked and paid. Call in the CONFIRMED stage for ALL journey types, AFTER sendClientBookingProposal has been sent and the client has paid."
    },
    {
      "function_name": "scheduleSoloCheckIns",
      "description": "Schedule proactive safety check-ins for the traveler's trip. Available to ALL journey types (medical, BYOJ, and leisure)."
    },
    {
      "function_name": "schedulePostOpCheckIns",
      "description": "Schedule post-operative recovery check-ins. MEDICAL/BYOJ only — NEVER call for LEISURE trips."
    },
    {
      "function_name": "schedulePostOpMedReminders",
      "description": "Schedule post-operative medication reminders for the patient's recovery. Call after the procedure date is confirmed. MEDICAL/BYOJ only — NEVER call for LEISURE trips."
    },
    {
      "function_name": "sendPreOpInstructions",
      "description": "Send the patient their pre-operative preparation instructions. Call once the procedure date is confirmed. MEDICAL/BYOJ only — NEVER call for LEISURE trips."
    },
    {
      "function_name": "sendPostOpInstructions",
      "description": "Send the patient post-operative care instructions. Call during recovery monitoring. MEDICAL/BYOJ only — NEVER call for LEISURE trips."
    },
    {
      "function_name": "escalateSoloCheckIn",
      "description": "Escalate a monitored event that has deviated to the next safety level. Available to ALL journey types."
    },
    {
      "function_name": "getVisaRequirement",
      "description": "Check visa requirements for the traveler's destination country. Available to ALL journey types where an international trip is involved."
    },
    {
      "function_name": "checkFlightStatus",
      "description": "Check a flight's live status by number or route. Use during MONITORING to anticipate delays before the traveler feels them. Never invent a status — only state what this returns. Available to ALL journey types."
    },
    {
      "function_name": "handleFlightDisruption",
      "description": "Act on a flight delay/cancellation detected during monitoring: rebooks/reroutes using real tools and notifies the traveler calmly. Call when checkFlightStatus or a disruption signal reports a real problem. The traveler never feels the panic — you absorb it. Available to ALL journey types."
    },
    {
      "function_name": "triggerSOS",
      "description": "Trigger an SOS emergency response for the traveler. Call ONLY in a genuine, traveler-confirmed emergency — never speculatively. Tell the traveler plainly what you did. Available to ALL journey types."
    },
    {
      "function_name": "activateEmergencyBeacon",
      "description": "Activate the traveler's emergency beacon to begin urgent monitoring. Call only in a confirmed safety emergency alongside the SOS path. Available to ALL journey types."
    },
    {
      "function_name": "requestEmergencyRecoveryTransport",
      "description": "Request emergency recovery transport for a traveler in distress. Call only when a monitored event has escalated to a real emergency. Available to ALL journey types."
    },
    {
      "function_name": "dispatchSoloSecurity",
      "description": "Dispatch a verified security agency to a solo traveler whose check-in has escalated. Call only via the escalation path (after escalateSoloCheckIn), never speculatively. Available to ALL journey types."
    },
    {
      "function_name": "handleCrisisReroute",
      "description": "The coordination-loop orchestrator. Call the moment anything breaks on a BOOKED journey — a provider cancels < 24h before the procedure, a flight is cancelled/delayed > 4h, a driver no-shows > 15 min, a companion flags patient distress, or a provider's credentials expire mid-trip. Pass case_id, crisis_type (PROVIDER_CANCELLED | FLIGHT_CANCELLED | DRIVER_NO_SHOW | COMPANION_DISTRESS | PROVIDER_CREDENTIAL_EXPIRED | EMERGENCY), detected_by (AI | PATIENT_REPORT | PROVIDER_MESSAGE | EXTERNAL_API), source_message (the incoming text/signal), and the original provider details if known. It looks up the matching BookingFallbackRule, executes the fallback action (auto-reassigns a verified backup doctor, dispatches a backup driver, or reroutes the flight via the existing handlers), sends the patient ONE calm 'I've already handled it' message across SMS + email, notifies every stakeholder (driver, travel agency, companion, admin), and writes a permanent CrisisReroute audit record with resolution time. Surface the returned patient_message verbatim in the chat — that is the reassurance. Returns human_escalated:true when a human must take over (no backup available, or the rule mandates it). NEVER say 'Let me look into that' when something breaks — call this first, then narrate. Available to ALL journey types once a booking exists."
    },
    {
      "function_name": "getRecoveryNutritionPlan",
      "description": "M-Care's recovery nutrition engine. Given a case_id (preferred — pulls procedure, procedure date, allergies, dietary restrictions, and culture from the case + consultation) OR explicit procedure_category + recovery_phase + allergies[] + dietary_restrictions[] + culture, returns the matching ProcedureDietaryProtocol for the current recovery phase, with recommended_foods FILTERED to remove anything clashing with the patient's allergies and dietary restrictions (nut allergy removes nuts; halal removes non-halal; vegetarian removes meat; vegan removes all animal products), foods_to_avoid with severity, hydration_protocol, supplement_recommendations, cultural_adaptations matched to the patient's culture, a derived shopping list, and safety notes. Computes the current recovery phase from the procedure_date when a case_id is given. Call it at the start of recovery and on each phase transition; present the plan as a caring, allergy-safe, culturally-adaptive nutritionist would (shopping list grouped by category, what to avoid and why, hydration, supplements). Always include the medical disclaimer: M-Care is not a dietitian; consult the patient's clinician before changing diet. Never invent nutrition data — only what the protocol returns; if found:false, give general hydration + protein guidance and flag that the clinician should specify the plan."
    },
    {
      "function_name": "getConciergeRecommendations",
      "description": "M-Care's proactive downtime concierge. Call during MONITORING/RECOVERY (medical) or downtime (leisure) to suggest recovery-friendly restaurants, gentle activities, and low-effort cultural experiences near the clinic/hotel, tailored to the patient's procedure and dietary needs. Pass case_id and an optional category (restaurant | activity | experience | mixed). It reads the case (clinic/hotel coords, procedure, consultation dietary profile) and uses live web context to return 5-7 real, named places with address + why it's recovery-friendly + a practical note. Surface each suggestion with a {{maps:LABEL|DESTINATION}} token using the returned address. Never invent a place — only what the tool returns. Available to ALL journey types."
    },
    {
      "function_name": "manageMedicalTravelGroup",
      "description": "Coordinate a medical-tourism group — multiple patients traveling together for the same procedure at the same destination. action 'create' (leader): pass group_name, group_leader_email, group_leader_name, procedure, destination_country, destination_city, travel_start_date, travel_end_date, member_emails[], member_names[], member_case_ids[], notes. Returns group_id. action 'join' (member): pass group_id, member_email, member_name, case_id. Adds the member. Each member keeps their own CaseRecord + own Safe-T screening — group coordination never bypasses individual safety. Shared logistics (same travel agency, driver pool, clinic window) get layered on top. Available to MEDICAL/BYOJ journey types."
    },
    {
      "function_name": "manageVerifiedCredential",
      "description": "Immutable, hash-chained credential storage — 'upload once, verify immutably'. action 'mint': call the moment a real verification tool approves a partner credential (runDoctorVerificationScan 'approved' for a doctor's license, verifyIATACode valid for a travel agency's IATA code, document-intelligence authentic for insurance/accreditation, admin_manual). Pass partner_type, partner_id, partner_name, credential_type (license|iata_code|insurance|accreditation|identity|business_registration|other), credential_reference (the license/IATA number), file_url (if vaulted), verified_by (the tool or 'admin_manual'), verification_source (registry|document_intelligence|admin_manual|iata_api|background_check), expires_at. It computes a SHA-256 credential_hash and links it to the partner's previous credential hash (GENESIS for the first), storing an immutable record. action 'verify_chain': pass partner_id to re-walk that partner's credential chain, recompute every hash, and report any break/tamper. Never mint before the real approval; never claim a credential is immutable/verified unless this tool returned it."
    },
    {
      "function_name": "detectPaymentDiscrepancies",
      "description": "Automated payment-discrepancy detector. Reminders + receipts already run automatically; this closes the gap by flagging underpaid (Paid In Full but amount_paid < final_package_price), overpaid, math mismatch (amount_remaining != final_package_price - amount_paid), and receipt-missing cases. Call it when a patient asks about their payment status or when you suspect a mismatch — it scans recent cases, flags discrepancies, and emails the admin a summary. Tell the patient plainly what it found (or that everything reconciles). Never fabricate a payment status this tool didn't return."
    },
    {
      "function_name": "generateGuardianLink",
      "description": "The Family Portal. Generate a zero-login guardian link so family at home can follow the traveler's journey (status, timeline, updates) and respond via guardianCheckIn/guardianEscalation. Call only with the traveler's explicit consent. Available to ALL journey types."
    },
    {
      "function_name": "manageTripPause",
      "description": "Pause or resume a traveler's trip monitoring (e.g. during a medical procedure so check-ins don't fire mid-surgery, or during a long-haul flight). Call only with an explicit reason and resume promptly afterward. Available to ALL journey types."
    },
    {
      "function_name": "sendGoldenMNotification",
      "description": "Issue the Golden M completion recognition when a traveler safely completes their journey and returns home. Call at trip completion for ALL journey types (standard, Bring Your Own Journey, and leisure)."
    },
    {
      "function_name": "mcareCreateTravelAgencyPending",
      "description": "The ONLY way to create a new TravelAgency record. Creates it as pending_verification and starts the real verification pipeline — you never write to the TravelAgency entity directly. Call this first, before verifyIATACode."
    },
    {
      "function_name": "flagIntakeHandoff",
      "description": "Hand this conversation to a human care-team member with full context so the patient never has to repeat themselves. Call this the moment someone directly asks for a human, or when you are genuinely uncertain about something consequential rather than guessing."
    },
    {
      "function_name": "verifyIATACode",
      "description": "Validate an IATA code format and look it up in real time via the IATA CheckACode API. Call before any travel-agency approve decision."
    },
    {
      "function_name": "checkAgencyWebsite",
      "description": "Fetch an agency's website URL to confirm it is live, capture the page title and HTTP status, and check SSL."
    },
    {
      "function_name": "reviewTravelAgencyVerification",
      "description": "Record M-Care's final decision for a travel-agency onboarding (approve/reject/escalate). Re-runs the IATA check on approve and refuses if not live-verified. Sends the agency an email."
    },
    {
      "function_name": "initiatePartnerVerification",
      "description": "Start the verification pipeline for ANY non-doctor partner type (taxi, companion, security). Call right after creating the pending partner record."
    },
    {
      "function_name": "generateChauffeurPortalLink",
      "description": "Generate the taxi-partner dashboard/portal link to deliver once taxi verification completes."
    },
    {
      "function_name": "getTaxiDriverCases",
      "description": "Fetch active trips/cases for a taxi partner or driver during handoff and recovery."
    },
    {
      "function_name": "sendDriverAlert",
      "description": "Send the driver a structured trip detail message (pickup, destination, traveler identifier, secure app link) via SMS."
    },
    {
      "function_name": "cancelDriverAssignment",
      "description": "Cancel the original driver's assignment so a backup can take over."
    },
    {
      "function_name": "escalateMissedDriverHandshake",
      "description": "Detect a missed GPS handshake check-in and auto-scan for a backup driver."
    },
    {
      "function_name": "reviewTaxiServiceVerification",
      "description": "Admin/human review action that sets a taxi partner's license/insurance verified. M-Care references the resulting verification_status to know when a taxi partner is truly verified."
    },
    {
      "function_name": "mcareCreateDoctorPending",
      "description": "The ONLY way to create a new Doctor record. Creates it as pending_verification — you never write to the Doctor entity directly. Call this first, before runDoctorVerificationScan."
    },
    {
      "function_name": "runDoctorVerificationScan",
      "description": "Run the full multi-layer doctor onboarding verification scan: internet/website presence, license registry, identity/passport, device+network intelligence, and background/sanctions — returns a confidence score (0-100), a decision (approved | flagged_for_admin_review), per-layer results, flags, and an audit step list. Call after creating the pending Doctor record with the doctor's website, license, and uploaded ID. Never claim a doctor is verified before this returns 'approved'."
    },
    {
      "function_name": "generateDoctorPortalLink",
      "description": "Generate the doctor's provider dashboard/portal link to deliver once their verification scan is approved."
    },
    {
      "function_name": "analyzeDocumentIntelligence",
      "description": "Forensic analysis of ANY document a partner uploads (license, IATA certificate, insurance, passport/ID, medical credential, business registration) as a chat file attachment or via the secure vault. Pass file_url plus the claimed values you already collected (partner_type, partner_id, claimed_iata_code, claimed_business_name, claimed_license_number, claimed_country, document_type_hint). It OCRs the doc, classifies it, extracts every code/name/date, assesses authenticity (authentic / likely_authentic / suspicious / likely_forged / indeterminate), detects forgery/anomaly signals, expiry, cross-checks extracted values vs what the partner claimed, and writes any HIGH/CRITICAL mismatch or forgery signal to the shared FraudIndicator table. Narrate the result using EXACTLY the tool output — never invent a finding. If authenticity is suspicious/likely_forged, OR any claimed value mismatches the document, OR the document is expired, do NOT approve — present the concern and escalate to admin review; for expiry, ask for a current document before proceeding."
    },
    {
      "function_name": "crossCheckFraudIndicators",
      "description": "Cross-match a partner's identifiers (emails[], phones[], domains[], names[]) against the shared FraudIndicator table and the confirmed FraudBlacklist BEFORE approving onboarding. Returns risk_level (critical | high | medium | low), matched_indicators, and a recommendation. critical/high = do NOT approve — tell the partner a verification concern was flagged and a human reviewer will follow up within 24h (never reveal the specific indicator or its source to the partner). medium = continue onboarding but flag for review. low = proceed normally. Call during every partner onboarding, right after you have the partner's contact details and before any approval decision."
    },
    {
      "function_name": "logMcarePerformance",
      "description": "Fire-and-forget analytics log for M-Care stage transitions and outcome checkpoints. Call on every journey stage advance (stage_from -> stage_to) and on key outcomes (safety gate result, consent logged, booking confirmed, monitoring scheduled, Golden M issued). Pass conversation_id, case_id (if known), stage_from, stage_to, journeyType (MEDICAL | BYOJ | LEISURE_PROTECT_ONLY), partner_type (for onboarding), outcome, and short notes. Never block the conversation on this call — it is analytics-only and best-effort; a failure here does not affect the traveler's journey."
    },
    {
      "function_name": "recallMcareKnowledge",
      "description": "Look up a question in M-Care's memorized brain (McareKnowledge). Returns the best matching previously-learned answer (stored at >=80% confidence) so you can answer instantly from memory instead of re-researching. Call this FIRST whenever a traveler/partner asks a factual question you're unsure of. If it returns found:false or no strong match, call mcareResearchAndLearn. Never diagnose or prescribe through this path."
    },
    {
      "function_name": "mcareResearchAndLearn",
      "description": "Research a question M-Care is stuck on and, if the answer is rated at least 80% confidence, persist it to the McareKnowledge brain for instant reuse next time. Uses live web context (non-diagnostic, factual answers only). Returns the answer, confidence_score, whether it was recalled vs freshly researched, and whether it was saved. Call this when recallMcareKnowledge found no strong match. Tell the traveler plainly whether you're confident; if confidence is below 80%, don't present it as certain and offer to escalate to the care team."
    }
  ],
  "context_files": [],
  "app_user_connector_configs": [],

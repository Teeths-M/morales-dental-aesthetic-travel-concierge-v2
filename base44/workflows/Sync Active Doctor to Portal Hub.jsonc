{
  "name": "Sync Active Doctor to Portal Hub",
  "description": "When a doctor is created or becomes active, sync them to Portal Hub's Doctor/Clinic section for workflow notifications",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Doctor"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_active_doctor_to_portal_hub",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncDoctorToPortalHub",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncDoctorToPortalHub"
  }
}
{
  "name": "Pipeline: Notify Travel Agencies + Chauffeurs on Doctor Confirmed",
  "description": "When a doctor confirms a case, automatically sends SMS + email to the patient (update), all active travel agencies (with their travel portal link), and all active chauffeurs (with their transfer portal link). Also advances the CaseRecord to Travel-Coordination.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"doctor_confirmation_status\") != null) and (.trigger.data.doctor_confirmation_status == \"CONFIRMED\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CaseRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pipeline_notify_travel_agencies_chauffeurs_on_doctor_confirmed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pipelineOnDoctorConfirmed",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pipelineOnDoctorConfirmed"
  }
}
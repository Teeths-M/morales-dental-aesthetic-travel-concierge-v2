{
  "name": "Auto-Activate Recovery Mode on Procedure Complete",
  "description": "Fires when a CaseRecord transitions to RECOVERY_PHASE_7_DAY status after clinic checkout handshake.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"procedure_complete_logged_at\") != null) and (.trigger.data.procedure_complete_logged_at != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CaseRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_activate_recovery_mode_on_procedure_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "activateRecoveryMode",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "activateRecoveryMode"
  }
}
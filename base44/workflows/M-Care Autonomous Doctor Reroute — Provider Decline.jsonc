{
  "name": "M-Care Autonomous Doctor Reroute \u2014 Provider Decline",
  "description": "Phase 2 heartbeat: the instant a WorkflowEvent's doctor_status flips to unavailable (doctor declined/can't take the case), M-Care reassigns the patient to the next best verified specialist on its own, then posts a proactive chat bubble + push so the traveler hears 'I caught that \u2014 I've already reassigned you' before they ever notice. Reuses autoReassignDoctorOnDecline for the reroute and adds the patient-facing message + CrisisReroute audit it was missing.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"doctor_status\") != null) and (.trigger.data.doctor_status == \"unavailable\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WorkflowEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "m_care_autonomous_doctor_reroute_provider_decline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "mcareAutonomousDoctorReroute",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "mcareAutonomousDoctorReroute"
  }
}
{
  "name": "Auto-assign doctor after SAFE-T passed",
  "description": "Automatically assigns doctor when SAFE-T result is PASSED",
  "trigger": {
    "condition": "${ (.trigger.data.safe_t_result == \"PASSED\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CaseRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_assign_doctor_after_safe_t_passed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "assignDoctorToCase",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "assignDoctorToCase"
  }
}
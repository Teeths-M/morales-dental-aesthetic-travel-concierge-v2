{
  "name": "Auto Reassign Doctor on Decline",
  "description": "Automatically reassigns case to next available doctor when current doctor declines",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"doctor_status\") != null) and (.trigger.data.doctor_status == \"declined\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WorkflowEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_reassign_doctor_on_decline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoReassignDoctorOnDecline",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoReassignDoctorOnDecline"
  }
}
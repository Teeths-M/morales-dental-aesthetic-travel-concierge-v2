{
  "name": "Auto Verify Doctor License",
  "description": "Automatically analyzes uploaded doctor licenses using AI vision when license_url is updated",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"license_url\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Doctor"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_verify_doctor_license",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "analyzeDoctorLicense",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "analyzeDoctorLicense"
  }
}
{
  "name": "Auto-assign chauffeur after travel vendor assigned",
  "description": "Automatically assigns chauffeur services when travel vendor is assigned",
  "trigger": {
    "condition": "${ (.trigger.data.travel_vendor_id != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CaseRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_assign_chauffeur_after_travel_vendor_assigned",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "assignChauffeurServices",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "assignChauffeurServices"
  }
}
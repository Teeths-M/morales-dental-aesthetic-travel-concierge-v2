{
  "name": "Auto-assign travel agency after doctor confirmed",
  "description": "Automatically assigns travel agency when doctor confirmation status is CONFIRMED",
  "trigger": {
    "condition": "${ (.trigger.data.doctor_confirmation_status == \"CONFIRMED\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CaseRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_assign_travel_agency_after_doctor_confirmed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "assignTravelAgency",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "assignTravelAgency"
  }
}
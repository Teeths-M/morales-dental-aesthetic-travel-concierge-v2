{
  "name": "WhatsApp Case Status Updates",
  "description": "Fires sendWhatsAppCaseUpdate whenever a CaseRecord status changes. Respects Stage 11 blackout protocol and patient opt-in consent.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CaseRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "whatsapp_case_status_updates",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWhatsAppCaseUpdate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendWhatsAppCaseUpdate"
  }
}
{
  "name": "Pipeline: Notify Patient + Doctor on Fee Paid",
  "description": "When a client pays their consultation fee, automatically sends SMS + email to the patient (with dashboard link) and to the assigned doctor (with their direct portal link).",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"fee_paid\") != null) and (.trigger.data.fee_paid == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ConsultationFee"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pipeline_notify_patient_doctor_on_fee_paid",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pipelineOnConsultationFeePaid",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pipelineOnConsultationFeePaid"
  }
}
{
  "name": "SecureShareLink",
  "type": "object",
  "properties": {
    "share_token": {
      "type": "string",
      "description": "Unique token for secure link (SHARE_<hex>)"
    },
    "vault_id": {
      "type": "string",
      "description": "Reference to PassportVault entity"
    },
    "passport_token": {
      "type": "string"
    },
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "description": "Optional: restrict to specific recipient"
    },
    "recipient_domain": {
      "type": "string",
      "description": "Optional: restrict to domain (e.g. embassy.gov)"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "embassy",
        "airline",
        "hotel",
        "insurance",
        "medical",
        "other"
      ],
      "default": "other"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_access_count": {
      "type": "number",
      "default": 1,
      "description": "Auto-revokes after N downloads"
    },
    "access_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by": {
      "type": "string"
    },
    "last_accessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_accessed_ip": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "share_token",
    "vault_id",
    "passport_token",
    "owner_email",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}

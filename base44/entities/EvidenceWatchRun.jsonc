{
  "name": "EvidenceWatchRun",
  "type": "object",
  "description": "One row per Medical Evidence Watch pipeline run (runEvidenceWatchOrchestrator) -- a structured audit trail of what a run searched, discovered, analyzed, evaluated, and queued for review, plus any per-item failures. Same 'small, standalone, admin-only operational log' shape as IncidentScanRun/ExternalSearchLog/CrisisReroute -- never folded into the hash-chained AuditLog, which is reserved for real human review decisions (see medical_evidence_approved/medical_evidence_rejected there). failures[] holds error messages only, never article bodies or PHI.",
  "properties": {
    "run_id": { "type": "string" },
    "trigger": { "type": "string", "enum": ["scheduled", "manual", "dry_run"] },
    "scope": { "type": "string", "enum": ["full", "recalls_only"], "default": "full", "description": "'full' runs PubMed/ClinicalTrials.gov/openFDA/Tavily across the full query set (monthly). 'recalls_only' runs just the openFDA recall/enforcement endpoints against a narrower device/drug query set (weekly)." },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "queries_run": { "type": "array", "items": { "type": "string" } },
    "counts": {
      "type": "object",
      "description": "{ discovered, deduped, analyzed, analysis_failures, evaluated, queued_for_review }"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": { "type": "string" },
          "url_or_query": { "type": "string" },
          "error_message": { "type": "string" }
        }
      },
      "description": "Error text only -- never article bodies or patient data."
    },
    "model_version": { "type": "string" },
    "dry_run": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["running", "completed", "completed_with_errors", "failed"], "default": "running" }
  },
  "required": ["run_id", "trigger", "started_at", "status"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

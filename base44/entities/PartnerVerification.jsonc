{
  "name": "PartnerVerification",
  "type": "object",
  "description": "The higher-assurance onboarding verification record for clinics, doctors, drivers, hotels, interpreters, and travel partners \u2014 the business/license/sanctions side, distinct from IdentityVerification (the person-identity side). Extended for M-Care TrustScan to carry the Persona inquiry reference for the partner principal's identity proofing, the verification level reached, consent reference, evidence ids, license-registry lookup (source URL + checked date + expiry/recheck date + reviewer), sanctions/adverse-media screening, payout-account ownership, live video verification for high-risk partners, and the public-bookable + suspension flags. No medical provider becomes publicly bookable until a human reviewer approves (VerificationReview). Recurring CredentialRecheck records drive expiry sweeps; expiry/failure suspends NEW bookings, never auto-cancels existing patient travel/appointments (those escalate to a human).",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "Reference to partner entity (Doctor/TravelAgency/TaxiService/Companion/SecurityAgency)."
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "doctor",
        "travel_agency",
        "taxi_service",
        "companion",
        "security_agency",
        "hotel",
        "interpreter"
      ],
      "description": "Type of partner being verified. Was 'companion_agency' historically \u2014 every real caller writes 'companion'."
    },
    "partner_name": {
      "type": "string",
      "description": "Partner or agency name for display."
    },
    "partner_email": {
      "type": "string",
      "format": "email"
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "basic",
        "identity_verified",
        "partner_verified",
        "medical_provider_approved"
      ],
      "default": "basic",
      "description": "The trust tier reached. Never one generic 'Verified' badge for all partner types."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "documents_received",
        "ai_analysis_complete",
        "manual_review",
        "verified",
        "denied",
        "suspended"
      ],
      "default": "pending",
      "description": "Current verification stage."
    },
    "persona_inquiry_id": {
      "type": "string",
      "description": "Persona Inquiry id backing the partner principal's own identity proofing (document + liveness), when run."
    },
    "consent_id": {
      "type": "string",
      "description": "The ConsentRecord id capturing explicit consent before this partner verification ran."
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "VerificationEvidence record ids backing each business/license/sanctions check."
    },
    "trust_profile_id": {
      "type": "string",
      "description": "The TrustProfile id computed from this verification."
    },
    "documents_uploaded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_type": {
            "type": "string",
            "enum": [
              "business_license",
              "professional_license",
              "insurance_certificate",
              "registration",
              "identity",
              "certification",
              "other"
            ]
          },
          "file_uri": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "ai_analysis_result": {
            "type": "object",
            "properties": {
              "tampering_detected": {
                "type": "boolean"
              },
              "forgery_indicators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ai_generated_probability": {
                "type": "number"
              },
              "confidence_score": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "business_identity": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "registration_number": {
          "type": "string"
        },
        "registration_country": {
          "type": "string"
        },
        "beneficial_contact_verified": {
          "type": "boolean"
        }
      },
      "description": "Legal business identity and beneficial-contact verification."
    },
    "license_registry": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "registry_name": {
          "type": "string"
        },
        "registry_url": {
          "type": "string",
          "description": "Official primary-source URL \u2014 never fabricated."
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "expiry_date": {
          "type": "string",
          "format": "date"
        },
        "recheck_due_date": {
          "type": "string",
          "format": "date"
        },
        "reviewer_id": {
          "type": "string"
        },
        "reviewer_name": {
          "type": "string"
        }
      },
      "description": "Clinician/facility license verification against the relevant official primary registry \u2014 source URL, checked date, expiry/recheck date, reviewer."
    },
    "facility_consistency": {
      "type": "object",
      "properties": {
        "address_phone_domain_consistent": {
          "type": "boolean"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Facility address/phone/domain consistency checks."
    },
    "payout_ownership": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "payout_method": {
          "type": "string"
        }
      },
      "description": "Business payout-account ownership verification."
    },
    "insurance_accreditation": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "evidence_uri": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Professional insurance/accreditation evidence where applicable."
    },
    "sanctions_screening": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "clear",
            "flagged",
            "manual_review"
          ]
        },
        "provider": {
          "type": "string",
          "description": "Licensed approved screening provider."
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "adverse_media_flagged": {
          "type": "boolean"
        }
      },
      "description": "Sanctions, adverse-media, and fraud-risk screening through licensed approved providers, subject to applicable law."
    },
    "video_verification": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "description": "True for high-risk partners."
        },
        "session_id": {
          "type": "string",
          "description": "Daily.co room id."
        },
        "completed": {
          "type": "boolean"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer_id": {
          "type": "string"
        }
      },
      "description": "Live video verification for high-risk partners (Daily.co)."
    },
    "ai_fraud_score": {
      "type": "number",
      "description": "AI-generated fraud risk score (0-100, higher = riskier).",
      "minimum": 0,
      "maximum": 100
    },
    "ai_fraud_indicators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific fraud indicators detected by AI."
    },
    "ai_analysis_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "regulatory_context": {
      "type": "string",
      "description": "Advisory note on the applicant's country's real regulatory/licensing body. Never auto-decides the outcome."
    },
    "manual_review_notes": {
      "type": "string",
      "description": "Notes from human reviewer."
    },
    "manual_reviewer_id": {
      "type": "string"
    },
    "manual_reviewer_name": {
      "type": "string"
    },
    "manual_review_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_publicly_bookable": {
      "type": "boolean",
      "default": false,
      "description": "True only after human review approves. No medical provider becomes publicly bookable until then."
    },
    "suspended": {
      "type": "boolean",
      "default": false,
      "description": "True when a credential expired/failed \u2014 suspends NEW bookings, escalates existing cases to a human."
    },
    "suspended_reason": {
      "type": "string"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "sandbox": {
      "type": "boolean",
      "default": true,
      "description": "True while Persona runs in sandbox."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string",
      "enum": [
        "ai_auto",
        "manual_review",
        "admin_override"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Verification expiry (re-verification required after)."
    },
    "denial_reason": {
      "type": "string"
    },
    "denied_at": {
      "type": "string",
      "format": "date-time"
    },
    "denied_by": {
      "type": "string"
    },
    "auto_verified": {
      "type": "boolean",
      "default": false,
      "description": "True if auto-verified by AI (fraud_score < 30)."
    },
    "requires_reverification": {
      "type": "boolean",
      "default": false
    },
    "reverification_due_date": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "partner_id",
    "partner_type",
    "partner_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
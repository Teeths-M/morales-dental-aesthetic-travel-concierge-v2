{
  "name": "CaseMessage",
  "type": "object",
  "properties": {
    "consultation_id": {
      "type": "string"
    },
    "from_user_id": {
      "type": "string"
    },
    "to_contact_id": {
      "type": "string",
      "description": "Doctor ID, 'coordinator', etc."
    },
    "message": {
      "type": "string"
    },
    "from_role": {
      "type": "string",
      "enum": [
        "patient",
        "doctor",
        "coordinator",
        "admin"
      ],
      "default": "patient"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of uploaded file URLs (lab results, documents, images)"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "consultation_id",
    "from_user_id",
    "message",
    "sent_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    }
  }
}
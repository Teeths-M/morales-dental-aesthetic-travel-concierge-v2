{
  "name": "CheckInToken",
  "type": "object",
  "properties": {
    "check_in_id": {
      "type": "string",
      "description": "References SoloCheckIn entity ID"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the raw token \u2014 raw token is never stored"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "24 hours from creation \u2014 token is invalid after this"
    },
    "used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Null until token is consumed \u2014 one-time use only"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "check_in_id",
    "token_hash",
    "expires_at"
  ]
}
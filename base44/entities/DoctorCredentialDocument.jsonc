{
  "name": "DoctorCredentialDocument",
  "description": "Immutable audit log of every credential document submitted by a doctor during verification. Cannot be deleted by the doctor — only by platform_admin, and all deletions are audit-logged. Provides the evidence trail for admin visual inspection during manual review.",
  "properties": {
    "doctor_id": {
      "type": "string",
      "description": "ID of the Doctor entity this document belongs to"
    },
    "doctor_email": {
      "type": "string",
      "description": "Email of the doctor at the time of upload (denormalized for audit resilience)"
    },
    "doctor_name": {
      "type": "string",
      "description": "Name of the doctor at the time of upload (denormalized for audit resilience)"
    },
    "document_type": {
      "type": "string",
      "enum": ["medical_license", "specialty_certificate", "photo_id", "proof_of_registration", "board_certification", "malpractice_insurance", "hospital_privileges", "other"],
      "description": "Category of credential document"
    },
    "document_type_label": {
      "type": "string",
      "description": "Human-readable label, e.g. 'Medical License (Front)'"
    },
    "file_url": {
      "type": "string",
      "description": "Stored file URL — images must be stored in platform file storage, not external URLs"
    },
    "file_name": {
      "type": "string",
      "description": "Original filename as uploaded"
    },
    "file_size_bytes": {
      "type": "number",
      "description": "File size at upload time"
    },
    "file_mime_type": {
      "type": "string",
      "description": "MIME type (image/jpeg, image/png, application/pdf, etc.)"
    },
    "country": {
      "type": "string",
      "description": "Country this credential was issued in (ISO-3166-1 alpha-2)"
    },
    "issuing_authority": {
      "type": "string",
      "description": "Name of the body that issued this credential, e.g. 'General Medical Council (UK)'"
    },
    "license_number": {
      "type": "string",
      "description": "License or registration number shown on this document"
    },
    "document_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Expiry date shown on the document, if applicable"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of upload — set by server, not user-controlled"
    },
    "verification_record_id": {
      "type": "string",
      "description": "ID of the associated DoctorVerification record this document supports"
    },
    "review_status": {
      "type": "string",
      "enum": ["pending_review", "accepted", "flagged", "rejected"],
      "default": "pending_review",
      "description": "Admin review status of this specific document"
    },
    "flagged_reason": {
      "type": "string",
      "description": "If review_status is 'flagged', the admin's stated reason. IMPORTANT: This system cannot detect forged documents with certainty — flagging is a human judgment call based on visual inspection."
    },
    "reviewed_by_admin_id": {
      "type": "string",
      "description": "User ID of the admin who last reviewed this document"
    },
    "reviewed_by_admin_email": {
      "type": "string",
      "description": "Email of the reviewing admin (denormalized for audit resilience)"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last admin review action"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin notes about this document — visible only to admins"
    }
  },
  "required": ["doctor_id", "doctor_email", "document_type", "file_url", "uploaded_at"]
}

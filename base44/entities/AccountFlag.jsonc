{
  "name": "AccountFlag",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "The flagged account"
    },
    "phone": {
      "type": "string",
      "description": "Normalised phone, when known. Flagged alongside the account so a new signup with the same number inherits the flag."
    },
    "tier": {
      "type": "string",
      "enum": [
        "warned",
        "restricted",
        "locked"
      ],
      "default": "warned",
      "description": "warned = logged only. restricted = commercial features blocked. locked = all commercial features blocked pending admin review."
    },
    "safety_paths_open": {
      "type": "boolean",
      "default": true,
      "description": "ALWAYS true. Safety features are never restricted by a flag. Present so the invariant is auditable."
    },
    "incidents": {
      "type": "array",
      "description": "Append-only history of detections. Samples are digit-masked by the engine.",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "sample": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "incident_count": {
      "type": "number",
      "default": 0
    },
    "first_flagged_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_flagged_at": {
      "type": "string",
      "format": "date-time"
    },
    "cleared_by": {
      "type": "string"
    },
    "cleared_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "tier"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
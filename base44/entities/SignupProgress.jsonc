{
  // A signup that was started but not finished, captured only once real
  // contact info (phone or email) exists so checkStalledSignups can reach
  // the person and invite them back — never behavioral/PHI detail, just
  // "who to nudge, about what flow, how far they got."
  //
  // No self-service read/write: written only by trackSignupAbandon via
  // asServiceRole (the client never gets direct entity access — same
  // reasoning as AccountFlag, which also holds phone numbers pre-account).
  "name": "SignupProgress",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Normalised phone, when captured. At least one of phone/email is always present."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "When captured. At least one of phone/email is always present."
    },
    "flow": {
      "type": "string",
      "enum": [
        "patient",
        "doctor",
        "travel_agency",
        "taxi_service",
        "companion",
        "security_agency"
      ],
      "description": "Which signup wizard this came from — matches signupDraft.js's `type` key."
    },
    "last_step_reached": {
      "type": "string",
      "description": "The step/module label the draft was on when contact info first appeared. Generic label only, never form field contents."
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Updated each time trackSignupAbandon sees the same phone/flow again, so checkStalledSignups measures time since last activity, not first."
    },
    "nudge_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "One-shot — checkStalledSignups never sends a second nudge for the same record."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set if the person is later confirmed to have finished signup, so checkStalledSignups can skip them. Left null otherwise."
    }
  },
  "required": [
    "flow",
    "first_seen_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}

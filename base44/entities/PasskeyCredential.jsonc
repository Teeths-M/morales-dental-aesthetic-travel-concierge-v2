{
  "name": "PasskeyCredential",
  "type": "object",
  "description": "One Face ID / fingerprint key (a passkey) a traveler set up to lock M-Care on their phone (base44/shared/passkeys.ts). The phone keeps the private key in its secure chip; this row holds only the public key, which can check a signature but can never make one. Once a traveler has an active key, M-Care locks after 5 minutes away and the server asks for a fresh Face ID / fingerprint check before the actions that switch help off or share private files. Admin-only: every write goes through managePasskeys or adminResetPhoneLock as the server.",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "The traveler, lowercased."
    },
    "user_id": {
      "type": "string"
    },
    "credential_id": {
      "type": "string",
      "description": "The passkey's own id, base64url."
    },
    "public_key": {
      "type": "string",
      "description": "The passkey's public key (COSE), base64url. Not a secret."
    },
    "counter": {
      "type": "number",
      "default": 0,
      "description": "Signature counter. Many phones always report 0; a counter that goes backwards is refused."
    },
    "transports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rp_id": {
      "type": "string",
      "description": "The web address the passkey belongs to (e.g. sentinel-dental-care.base44.app). A passkey only works on the address it was made on."
    },
    "device_label": {
      "type": "string",
      "description": "A name the traveler sees in Settings, e.g. \"iPhone\". Never used for anything else."
    },
    "backed_up": {
      "type": "boolean",
      "description": "True when the phone syncs this passkey (iCloud Keychain, Google Password Manager), so a new phone signed into the same account can still unlock."
    },
    "status": {
      "type": "string",
      "enum": ["active", "removed"],
      "default": "active"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "removed_at": {
      "type": "string",
      "format": "date-time"
    },
    "removed_reason": {
      "type": "string",
      "description": "removed_by_traveler or reset_by_care_team: <reason>."
    }
  },
  "required": ["user_email", "credential_id", "public_key", "rp_id", "status"],
  "rls": {
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    },
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    }
  }
}

{
  "name": "QuoteMessage",
  "type": "object",
  "description": "On-platform clarification thread between a patient and a doctor/partner about a quote or case. Distinct from the general 'CaseMessage' entity. Contact details are scrubbed at the quote stage.",
  "properties": {
    "case_id": { "type": "string" },
    "quote_id": { "type": "string" },
    "patient_email": { "type": "string", "format": "email", "description": "Denormalised so RLS scopes the thread to its participants" },
    "doctor_email": { "type": "string", "format": "email" },
    "from_party": {
      "type": "string",
      "enum": ["patient", "doctor", "travel_agency", "taxi_service", "companion", "security_agency", "admin"],
      "default": "patient"
    },
    "from_id": { "type": "string" },
    "to_party": { "type": "string" },
    "message_type": { "type": "string", "enum": ["info_request", "message", "answer"], "default": "message" },
    "body": { "type": "string" },
    "body_translated": { "type": "string" },
    "recipient_language": { "type": "string" },
    "contact_scrubbed": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["unread", "read", "answered"], "default": "unread" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["case_id", "message_type", "body"],
  "rls": {
    "read": {
      "$or": [
        { "data.patient_email": "{{user.email}}" },
        { "data.doctor_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "isAuthenticated": true } }
  }
}

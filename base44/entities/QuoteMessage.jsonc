{
  "name": "QuoteMessage",
  "type": "object",
  "description": "On-platform clarification thread between a patient and a doctor/partner about a quote or case. Distinct from the general 'CaseMessage' entity. Contact details are scrubbed at the quote stage.",
  "properties": {
    "case_id": { "type": "string" },
    "quote_id": { "type": "string" },
    "patient_email": { "type": "string", "format": "email", "description": "Denormalised so RLS scopes the thread to its participants" },
    "doctor_email": { "type": "string", "format": "email" },
    "from_party": {
      "type": "string",
      "enum": ["patient", "doctor", "travel_agency", "taxi_service", "companion", "security_agency", "admin", "m_care"],
      "default": "patient"
    },
    "from_id": { "type": "string" },
    "to_party": { "type": "string" },
    "message_type": { "type": "string", "enum": ["info_request", "message", "answer"], "default": "message" },
    "body": { "type": "string" },
    "body_translated": { "type": "string" },
    "recipient_language": { "type": "string" },
    "contact_scrubbed": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["unread", "read", "answered"], "default": "unread" },
    "requires_confirmation": {
      "type": "boolean",
      "default": false,
      "description": "Set by M-Care on a message that needs the addressed party to explicitly confirm understanding (e.g. a parsed appointment time or instruction) — the Care Room's Confirmation Engine. Never set true by a raw client write; only via postCaseMessage's own parse step or confirmCareRoomMessage."
    },
    "confirmed": { "type": "boolean", "default": false },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "medication_id": {
      "type": "string",
      "description": "Set only by postCaseMessage's reactive pipeline when a doctor's message contained a medication instruction — links this confirm bubble to the real Medication record confirmCareRoomMessage flips on confirm. Blank for every other message."
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["case_id", "message_type", "body"],
  "rls": {
    "read": {
      "$or": [
        { "data.patient_email": "{{user.email}}" },
        { "data.doctor_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "id": "{{user.id}}" } }
  }
}

{
  "name": "RecoveryTransportRequest",
  "type": "object",
  "properties": {
    "request_token": {
      "type": "string",
      "description": "RTRANS_<hex> unique reference"
    },
    "case_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "user_name": {
      "type": "string"
    },
    "requested_by": {
      "type": "string",
      "enum": [
        "patient",
        "shopkeeper",
        "admin",
        "guardian"
      ],
      "default": "patient"
    },
    "pickup_latitude": {
      "type": "number"
    },
    "pickup_longitude": {
      "type": "number"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_location_source": {
      "type": "string",
      "enum": [
        "gps",
        "ip_geo",
        "manual"
      ],
      "default": "gps"
    },
    "destination_address": {
      "type": "string",
      "description": "Hotel/safe location"
    },
    "destination_latitude": {
      "type": "number"
    },
    "destination_longitude": {
      "type": "number"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_phone": {
      "type": "string"
    },
    "driver_location_token": {
      "type": "string",
      "description": "For driver-assigned requests, the LiveLocationRequest token the driver uses to stream their GPS. The traveler's inline map widget reads this (via getDriverLocationStatus) to render the driver's approaching dot in real time."
    },
    "driver_share_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 3-minute 'your passenger is waiting' retry SMS was sent to the driver. Dedup so the scheduled sweep never sends it twice."
    },
    "driver_share_care_team_alerted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 5-minute 'driver hasn't shared \u2014 call them' alert went to the M-Care care team. Dedup so the sweep never re-alerts."
    },
    "visual_verification_token_id": {
      "type": "string"
    },
    "payment_transaction_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending_capture",
        "emergency_transport_authorized",
        "captured",
        "failed",
        "waived"
      ],
      "default": "pending_capture"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "dispatched",
        "driver_assigned",
        "en_route",
        "arrived",
        "completed",
        "cancelled",
        "no_driver"
      ],
      "default": "requested"
    },
    "notes": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "dispatched_at": {
      "type": "string",
      "format": "date-time"
    },
    "arrived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the transport was marked arrived \u2014 set by the geofence auto-arrival detector in the traveler's widget (or manually by an admin)."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "request_token",
    "user_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
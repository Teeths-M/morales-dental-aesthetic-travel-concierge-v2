{
  "name": "ContactAttempt",
  "type": "object",
  "description": "Audit log of every real outbound message Morales sends to a provider partner on a traveler's behalf (a travel-agency/driver quote request, a doctor case-assignment notice, a partner verification-outcome notice). Written by logProviderContactAttempt.ts, which every real dispatcher (assignTravelAgency, assignChauffeurServices, assignDoctorToCase, initiatePartnerVerification) calls right after its own real send. This is the honest, buildable version of the 'governed outreach' auditability the M-Care provider-intelligence spec asked for — it logs outreach that already happens today; it does not perform outreach and never contacts a provider Morales hasn't already onboarded. Provider-facing metadata only (recipient is the partner's own business email/phone) — never a patient name, medical detail, or other patient PHI.",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "The CaseRecord this outreach was on behalf of."
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "doctor",
        "travel_agency",
        "taxi_service",
        "companion",
        "security_agency",
        "other"
      ]
    },
    "partner_id": {
      "type": "string",
      "description": "The Doctor/TravelAgency/TaxiService/etc. record id, when known."
    },
    "partner_name": {
      "type": "string",
      "description": "The provider's own business/display name — not patient data."
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "whatsapp"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "quote_request",
        "case_assignment",
        "verification_notification",
        "other"
      ]
    },
    "recipient": {
      "type": "string",
      "description": "The provider's own business email/phone contacted — never a patient's."
    },
    "initiated_by": {
      "type": "string",
      "description": "The function that sent it, e.g. 'assignTravelAgency'."
    },
    "result": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "skipped"
      ]
    },
    "error_detail": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "partner_type",
    "channel",
    "purpose",
    "result",
    "initiated_by"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "voice",
        "email",
        "push",
        "admin",
        "webhook"
      ],
      "default": "email"
    },
    "case_id": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "traveler",
        "guardian",
        "admin",
        "security",
        "system",
        "partner"
      ],
      "default": "traveler"
    },
    "recipient_phone": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string",
      "format": "email"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "safety_reminder",
        "voice_call",
        "guardian_alert",
        "security_dispatch",
        "police_escalation_task",
        "stale_signal_alert",
        "inbound_sms",
        "check_in_link",
        "sos_alert",
        "welcome",
        "general"
      ],
      "default": "general"
    },
    "provider_message_id": {
      "type": "string",
      "description": "Twilio SID or email provider ID \u2014 used for idempotency"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "failed",
        "provider_not_configured",
        "no_phone",
        "no_email",
        "received_sos",
        "safe_acknowledged",
        "safe_already_acked",
        "unrecognized_command",
        "logged"
      ],
      "default": "sent"
    },
    "escalation_level": {
      "type": "number",
      "default": 0,
      "description": "1=SMS, 2=Voice, 3=Guardian, 4=Security, 5=Police"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "channel"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "EmailQueue",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Unique job identifier (EMAIL_<hex>)"
    },
    "recipient_email": {
      "type": "string",
      "format": "email"
    },
    "subject": {
      "type": "string"
    },
    "body_html": {
      "type": "string"
    },
    "body_text": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "welcome",
        "password_reset",
        "notification",
        "receipt",
        "transactional",
        "custom"
      ],
      "default": "custom"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "sent",
        "failed",
        "retrying"
      ],
      "default": "pending"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "max_retries": {
      "type": "number",
      "default": 3
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "recipient_email",
    "subject"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "OtpSession",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Sanitized phone number including country code (phone-channel sessions only)"
    },
    "email": {
      "type": "string",
      "description": "Lowercased email address (email-channel sessions only)"
    },
    "channel": {
      "type": "string",
      "enum": ["phone", "email"],
      "default": "phone",
      "description": "Delivery channel this OTP was sent over"
    },
    "code": {
      "type": "string",
      "description": "6-digit OTP code"
    },
    "expires_at": {
      "type": "string",
      "description": "ISO timestamp — code invalid after this time"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "True once the code has been successfully used (single-use enforcement)"
    }
  },
  "required": ["code", "expires_at"],
  "rls": {
    "read":   { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

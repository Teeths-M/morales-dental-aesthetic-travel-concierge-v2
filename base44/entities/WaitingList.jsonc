{
  "name": "WaitingList",
  "type": "object",
  "properties": {
    "patient_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "desired_month": {
      "type": "string",
      "description": "Format: YYYY-MM"
    },
    "procedure_interest": {
      "type": "string"
    },
    "consultation_id": {
      "type": "string",
      "description": "Link to existing consultation if applicable"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "notified",
        "converted",
        "expired"
      ],
      "default": "waiting"
    },
    "notified_at": {
      "type": "string",
      "description": "ISO timestamp when slot offer was sent"
    },
    "offer_expires_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 48h after notified_at"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "patient_name",
    "email",
    "desired_month"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}

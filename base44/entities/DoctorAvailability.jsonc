{
  "name": "DoctorAvailability",
  "type": "object",
  "properties": {
    "doctor_id": {
      "type": "string",
      "description": "Reference to Doctor entity"
    },
    "doctor_email": {
      "type": "string",
      "format": "email",
      "description": "Doctor's email for quick lookup"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "The specific date (YYYY-MM-DD)"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether the doctor is available on this date"
    },
    "time_slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available time slots (e.g. ['09:00', '10:00', '14:00'])"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about availability"
    },
    "locked_case_id": {
      "type": "string",
      "description": "Set by confirmProcedureDate when a case books this date (double-booking slot lock)"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "consultation_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": { "type": "string", "description": "HH:MM, doctor's local clinic time." },
          "duration_minutes": { "type": "number", "default": 30 },
          "booked_by_virtual_consultation_id": { "type": "string" },
          "locked_at": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Slot-level lock for virtual consultations, written by bookVirtualConsultation via a read-then-compare-and-swap write (the same pattern confirmProcedureDate already uses on this entity). Deliberately SEPARATE from time_slots (free-text, unstructured, still used only for display) and from locked_case_id/is_available (the existing DAY-level lock confirmProcedureDate uses for the actual procedure date) — the two locking systems must never cross-reference."
    }
  },
  "required": [
    "doctor_id",
    "doctor_email",
    "date"
  ]
}
{
  "name": "Doctor",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Doctor's full name"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "clinic_country": {
      "type": "string",
      "description": "Country where clinic is located"
    },
    "clinic_city": {
      "type": "string",
      "description": "City where clinic is located"
    },
    "clinic_name": {
      "type": "string",
      "description": "Clinic name (optional)"
    },
    "professional_background": {
      "type": "string",
      "description": "Education, certifications, and professional credentials"
    },
    "years_experience": {
      "type": "number"
    },
    "bio": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "license_url": {
      "type": "string",
      "description": "URL to uploaded medical license"
    },
    "license_number": {
      "type": "string",
      "description": "Official medical license number"
    },
    "country": {
      "type": "string",
      "description": "Country of medical license issuance"
    },
    "specialty": {
      "type": "string",
      "description": "Medical specialty"
    },
    "license_verified": {
      "type": "boolean",
      "default": false
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verifying",
        "verified",
        "failed",
        "manually_approved",
        "pending_manual",
        "rejected",
        "suspended"
      ],
      "default": "pending_verification",
      "description": "Overall verification state"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "government_registry",
        "advisory_team",
        "manual_upload"
      ],
      "description": "How the doctor was verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When verification was completed"
    },
    "credential_verified_date": {
      "type": "string",
      "format": "date-time",
      "description": "When credentials were last CONFIRMED against the official registry (the 'last verified' shown to users). Only refreshed on a real positive registry hit — never on a guess."
    },
    "license_last_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the scheduled re-check last RAN (whether or not it could confirm). Lets the scheduler avoid re-hitting the same doctor daily; distinct from credential_verified_date."
    },
    "verification_confidence": {
      "type": "number",
      "description": "AI confidence score 0-100%"
    },
    "verification_notes": {
      "type": "string",
      "description": "AI or admin notes about verification"
    },
    "identity_verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "initiated",
        "passed",
        "failed",
        "manual_override"
      ],
      "default": "pending"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "initiated",
        "passed",
        "failed",
        "manual_override"
      ],
      "default": "pending"
    },
    "license_verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "manual_override"
      ],
      "default": "pending"
    },
    "verification_can_be_activated": {
      "type": "boolean",
      "default": false,
      "description": "True only if all checks passed or overridden"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "wipay"
      ]
    },
    "payout_account": {
      "type": "string"
    },
    "language_preference": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "pt",
        "de",
        "it",
        "tr",
        "th",
        "zh"
      ],
      "default": "en",
      "description": "Matches src/i18n.js's SUPPORTED_LANGUAGES exactly, so a doctor's language can be represented for every language M actually offers (added tr/th/zh 2026-08-05 for doctor-reminder translation coverage)."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "active",
        "inactive"
      ],
      "default": "pending_verification"
    },
    "rating": {
      "type": "number",
      "default": 5.0
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "successful_procedures_count": {
      "type": "number",
      "default": 0
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "title": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string"
          }
        }
      }
    },
    "sign_up_completed_at": {
      "type": "string"
    },
    "website_url": {
      "type": "string",
      "description": "Clinic or personal website URL"
    },
    "social_facebook": {
      "type": "string",
      "description": "Facebook page handle"
    },
    "social_instagram": {
      "type": "string",
      "description": "Instagram handle"
    },
    "social_tiktok": {
      "type": "string",
      "description": "TikTok handle"
    },
    "internet_risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Internet intelligence risk classification"
    },
    "internet_risk_score": {
      "type": "number",
      "description": "Raw risk score 0–100 (lower = safer)"
    },
    "internet_summary": {
      "type": "string",
      "description": "AI-generated plain-English summary of the internet risk assessment"
    },
    "internet_signals": {
      "type": "object",
      "description": "Full signal breakdown: domain age, social checks, phone flags, AI credibility"
    },
    "internet_last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "When the internet intelligence scan was last run"
    },
    "legal_business_name": {
      "type": "string",
      "description": "The doctor's real legal business/clinic entity name, for the Provider Trust Profile — distinct from the display clinic_name."
    },
    "legal_business_country": {
      "type": "string",
      "description": "Country of legal business registration. May differ from clinic_country for a multi-location group."
    },
    "license_authority": {
      "type": "string",
      "description": "The real issuing regulatory body's name (e.g. 'Consejo Superior de Salud, Colombia') — distinct from country, which is issuance country only."
    },
    "accreditation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "issuing_body": { "type": "string" },
          "certificate_url": { "type": "string" },
          "verified": { "type": "boolean", "default": false }
        }
      },
      "description": "Self-reported at signup. verified flips true only through the same admin review path as license/identity verification — never set automatically."
    },
    "consultation_price_amount": { "type": "number" },
    "consultation_price_currency": { "type": "string", "default": "USD" },
    "cancellation_policy": { "type": "string" },
    "escalation_contact_name": { "type": "string" },
    "escalation_contact_email": { "type": "string", "format": "email" },
    "escalation_contact_phone": { "type": "string" },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" },
          "added_by": { "type": "string" },
          "added_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "clinic_timezone": {
      "type": "string",
      "description": "IANA zone, e.g. 'America/Bogota'. Optional — the booking UI falls back to a hand-curated country-to-timezone hint (same non-authoritative-constant pattern as visaMatrix.js) and says so plainly when unset."
    },
    "booking_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Set true ONLY by the deterministic sweepProviderBookingEligibility sweep (block direction only, matching 'AI/automated code may raise caution, never clear it'). Cleared ONLY by clearProviderBookingSuspension (admin-only, requires override_reason, mirrors bookingState.ts's clearHold discipline)."
    },
    "booking_suspended_reason": { "type": "string" },
    "booking_suspended_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "full_name",
    "email",
    "phone",
    "clinic_country",
    "clinic_city"
  ]
}
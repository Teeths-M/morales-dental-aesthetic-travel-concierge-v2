{
  "name": "JourneyEvent",
  "type": "object",
  "description": "A persistent record of one autonomous, proactive thing M-Care's scheduled automation did for a patient's journey (a departure-countdown milestone reminder, a journey marked complete, etc.) \u2014 written only by trusted scheduled functions via asServiceRole, never by a client. The frontend polls this per-case and renders message_text as a normal M-Care chat bubble, so the patient sees a proactive message without M-Care needing to inject anything into the live agent conversation (which the SDK has no mechanism for). message_text is the ONLY field ever shown to the patient \u2014 it is deterministic, reused copy, never LLM-generated, and never claims an action beyond what the writing function actually confirmed. tool_result/action_taken are audit-only detail, not for direct display.",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "The CaseRecord this event belongs to."
    },
    "client_email": {
      "type": "string",
      "format": "email",
      "description": "Denormalized for RLS \u2014 the patient owns their own journey events."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "departure_milestone_14d",
        "departure_milestone_7d",
        "departure_milestone_3d",
        "departure_milestone_1d",
        "departure_day_of",
        "journey_completed",
        "recovery_checkin_day3",
        "driver_noshow_backup",
        "doctor_backup_dispatched",
        "doctor_confirmation_delay_flagged",
        "flight_disruption_handled",
        "weather_advisory",
        "guardian_checkin_sent",
        "ride_dispatched",
        "guardian_alert_sent",
        "document_vaulted"
      ]
    },
    "source": {
      "type": "string",
      "description": "The function that created this record, e.g. 'sendTravelCountdownReminders' or 'autoCompletePatientJourney'."
    },
    "message_text": {
      "type": "string",
      "description": "The exact, pre-reviewed sentence rendered as the M-Care chat bubble. Never freeform/LLM-authored \u2014 always a fixed template filled with real values."
    },
    "action_taken": {
      "type": "string",
      "description": "Plain-language audit note of what the source function actually did (e.g. 'Sent milestone reminders to 3 parties')."
    },
    "tool_result": {
      "type": "object",
      "description": "Real structured outcome data for audit purposes only \u2014 never interpolated directly into a patient-facing bubble."
    },
    "user_action_required": {
      "type": "boolean",
      "default": false
    },
    "escalation_occurred": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "How this event is communicated: low = in-app chat bubble only; medium/high/critical additionally trigger a push notification (high/critical mark it as requiring interaction, not auto-dismissing). Set explicitly by the writing function from data it actually computed \u2014 never a default, never inferred client-side."
    }
  },
  "required": [
    "case_id",
    "client_email",
    "event_type",
    "source",
    "message_text",
    "priority"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "OfflineHandshake",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "patient_email": {
      "type": "string",
      "format": "email"
    },
    "patient_name": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "qr_token",
        "emergency_pin"
      ],
      "default": "sms"
    },
    "shortcode_command": {
      "type": "string",
      "description": "e.g. DRIVER abc123, CHECKIN ok, SOS"
    },
    "raw_message": {
      "type": "string"
    },
    "parsed_action": {
      "type": "string"
    },
    "parsed_payload": {
      "type": "object"
    },
    "message_sid": {
      "type": "string",
      "description": "Twilio MessageSid \u2014 idempotency key, prevents duplicate processing of the same inbound SMS"
    },
    "checkpoint_id": {
      "type": "string",
      "description": "The checkpoint reference a driver/patient confirms via SMS"
    },
    "handshake_role": {
      "type": "string",
      "enum": [
        "checkin",
        "driver",
        "patient",
        "sos",
        "unknown"
      ],
      "description": "Which role this handshake checkpoint expects"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "missed",
        "escalated",
        "expired",
        "rejected"
      ],
      "default": "pending"
    },
    "expected_phone": {
      "type": "string",
      "description": "If set, only this phone number may complete the checkpoint"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Checkpoint is invalid after this time"
    },
    "primary_driver_id": {
      "type": "string"
    },
    "primary_driver_phone": {
      "type": "string"
    },
    "backup_driver_id": {
      "type": "string"
    },
    "backup_driver_phone": {
      "type": "string"
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed": {
      "type": "boolean",
      "default": false
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_result": {
      "type": "string"
    },
    "qr_token": {
      "type": "string"
    },
    "emergency_pin": {
      "type": "string"
    },
    "pin_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "from_phone": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "handshake_type": {
      "type": "string",
      "enum": [
        "driver_pickup",
        "airport_dropoff",
        "hotel_checkin",
        "clinic_arrival",
        "clinic_departure",
        "airport_checkin",
        "airport_boarding",
        "hotel_checkout",
        "recovery_handoff",
        "home_dropoff"
      ],
      "description": "The physical event being confirmed"
    },
    "trip_id": {
      "type": "string",
      "description": "Links to a specific trip / travel leg"
    },
    "method": {
      "type": "string",
      "enum": ["tap", "sms", "system"],
      "description": "How this handshake was confirmed"
    },
    "confirmed_by": {
      "type": "string",
      "description": "User ID or phone number that confirmed the handshake"
    },
    "confirmed_by_name": {
      "type": "string"
    },
    "gps_lat": {
      "type": "number",
      "description": "GPS latitude captured at confirmation"
    },
    "gps_lng": {
      "type": "number",
      "description": "GPS longitude captured at confirmation"
    },
    "gps_accuracy_m": {
      "type": "number",
      "description": "GPS accuracy in metres"
    },
    "offline_packet_id": {
      "type": "string",
      "description": "Links this record to an offline queue entry for reconciliation"
    },
    "timeout_at": {
      "type": "string",
      "format": "date-time",
      "description": "Auto-computed as created_date + 15 min; the cron marks status=timeout after this"
    },
    "rerouted": {
      "type": "boolean",
      "default": false,
      "description": "True once a replacement driver has been auto-assigned after timeout"
    },
    "reroute_driver_id": {
      "type": "string"
    },
    "reroute_triggered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "channel"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}

{
  "name": "OfflineHandshake",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "patient_email": {
      "type": "string",
      "format": "email"
    },
    "patient_name": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "qr_token",
        "emergency_pin"
      ],
      "default": "sms"
    },
    "shortcode_command": {
      "type": "string",
      "description": "e.g. AGENCY FLIGHT DELAY, CHECKIN OK, SOS"
    },
    "raw_message": {
      "type": "string"
    },
    "parsed_action": {
      "type": "string"
    },
    "parsed_payload": {
      "type": "object"
    },
    "executed": {
      "type": "boolean",
      "default": false
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_result": {
      "type": "string"
    },
    "qr_token": {
      "type": "string"
    },
    "emergency_pin": {
      "type": "string"
    },
    "pin_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "from_phone": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "channel"
  ]
}
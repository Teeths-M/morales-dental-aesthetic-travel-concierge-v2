{
  "name": "SecurityAgency",
  "type": "object",
  "properties": {
    "agency_name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "years_in_operation": {
      "type": "number"
    },
    "personnel_count": {
      "type": "string",
      "enum": [
        "1-5",
        "6-20",
        "21-50",
        "50+"
      ]
    },
    "background_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. Ex-Military, Ex-Police, Private Security, Tactical Response"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operational_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_armored_vehicles": {
      "type": "boolean",
      "default": false
    },
    "response_time_minutes": {
      "type": "number"
    },
    "license_doc_url": {
      "type": "string"
    },
    "insurance_doc_url": {
      "type": "string"
    },
    // The same three clearances Doctor, Companion and TaxiService already
    // carry. SecurityAgency had none of them — the partner type that puts a
    // person physically alongside a sedated or recovering patient was the only
    // one with no per-check state to gate activation on, so there was nothing
    // for an activation gate to read. Added so activatePartner can refuse to
    // make a security agency bookable until each one is positively cleared.
    "identity_verification_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "manual_override"],
      "default": "pending"
    },
    "background_check_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "manual_override"],
      "default": "pending",
      "description": "Criminal-record clearance. Only ever set by a human decision — no automated scan may mark this passed."
    },
    "license_verification_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "manual_override"],
      "default": "pending"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "under_review",
        "verified",
        "rejected",
        "suspended",
        "pending_manual"
      ],
      "default": "pending_review"
    },
    "kyp_verification_id": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    },
    "is_available": {
      "type": "boolean",
      "default": false
    },
    "sos_alerts_enabled": {
      "type": "boolean",
      "default": false
    },
    "total_responses": {
      "type": "number",
      "default": 0
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agency_name",
    "contact_person",
    "email",
    "phone",
    "country"
  ]
}
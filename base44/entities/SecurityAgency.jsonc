{
  "name": "SecurityAgency",
  "type": "object",
  "properties": {
    "agency_name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "years_in_operation": {
      "type": "number"
    },
    "personnel_count": {
      "type": "string",
      "enum": [
        "1-5",
        "6-20",
        "21-50",
        "50+"
      ]
    },
    "background_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. Ex-Military, Ex-Police, Private Security, Tactical Response"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. SOS Response, Close Protection, Airport Escort, Medical Escort, Surveillance"
    },
    "operational_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_armored_vehicles": {
      "type": "boolean",
      "default": false
    },
    "response_time_minutes": {
      "type": "number"
    },
    "license_doc_url": {
      "type": "string"
    },
    "insurance_doc_url": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "under_review",
        "verified",
        "rejected",
        "suspended"
      ],
      "default": "pending_review"
    },
    "kyp_verification_id": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    },
    "is_available": {
      "type": "boolean",
      "default": false
    },
    "sos_alerts_enabled": {
      "type": "boolean",
      "default": false
    },
    "total_responses": {
      "type": "number",
      "default": 0
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agency_name",
    "contact_person",
    "email",
    "phone",
    "country"
  ]
}
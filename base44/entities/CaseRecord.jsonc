{
  "name": "CaseRecord",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "Submitted",
        "Safe-T-Reviewed",
        "Doctor-Pending",
        "Vendor-Pending",
        "Admin-Review",
        "Proposal-Sent",
        "PMP-25",
        "PMP-50",
        "Deposit-Paid",
        "Travel-Coordination",
        "Ready-For-Travel",
        "Procedure-In-Progress",
        "SURGICAL_EXECUTION_WINDOW",
        "RECOVERY_PHASE_7_DAY",
        "Recovery",
        "Completed",
        "waiver_refused",
        "companion_required_pending",
        "companion_required_waived"
      ],
      "default": "Submitted"
    },
    "case_priority": {
      "type": "string",
      "enum": [
        "Normal",
        "Urgent",
        "Critical"
      ],
      "default": "Normal"
    },
    "consultation_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string",
      "format": "email"
    },
    "client_phone": {
      "type": "string"
    },
    "client_country": {
      "type": "string"
    },
    "whatsapp_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Patient has opted in to receive WhatsApp notifications"
    },
    "emergency_contact": {
      "type": "string"
    },
    "procedure_country": {
      "type": "string"
    },
    "client_pickup_address": {
      "type": "string"
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consultation_summary": {
      "type": "string"
    },
    "risk_score": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High"
      ]
    },
    "safe_t_result": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASSED",
        "BLOCKED"
      ],
      "default": "PENDING"
    },
    "safe_t_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doctor_selected": {
      "type": "string"
    },
    "clinic_selected": {
      "type": "string"
    },
    "medications": {
      "type": "string"
    },
    "allergies": {
      "type": "string"
    },
    "smoking_status": {
      "type": "boolean",
      "default": false
    },
    "alcohol_use": {
      "type": "string"
    },
    "medical_conditions": {
      "type": "string"
    },
    "anesthesia_history": {
      "type": "string"
    },
    "mental_health_notes": {
      "type": "string"
    },
    "pregnancy_status": {
      "type": "boolean",
      "default": false
    },
    "exercise_level": {
      "type": "string"
    },
    "doctor_email": {
      "type": "string",
      "format": "email"
    },
    "doctor_portal_token": {
      "type": "string"
    },
    "treatment_cost": {
      "type": "number",
      "default": 0
    },
    "treatment_duration": {
      "type": "number"
    },
    "recovery_days": {
      "type": "number",
      "default": 0
    },
    "doctor_confirmation_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "DECLINED"
      ],
      "default": "PENDING"
    },
    "doctor_notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "doctor_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "travel_vendor_id": {
      "type": "string"
    },
    "flight_cost": {
      "type": "number",
      "default": 0
    },
    "flight_details": {
      "type": "string"
    },
    "hotel_cost": {
      "type": "number",
      "default": 0
    },
    "hotel_name": {
      "type": "string"
    },
    "hotel_address": {
      "type": "string"
    },
    "itinerary_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SUBMITTED",
        "CONFIRMED"
      ],
      "default": "PENDING"
    },
    "origin_driver_id": {
      "type": "string"
    },
    "destination_driver_id": {
      "type": "string"
    },
    "pickup_cost": {
      "type": "number",
      "default": 0
    },
    "dropoff_cost": {
      "type": "number",
      "default": 0
    },
    "local_transfer_cost": {
      "type": "number",
      "default": 0
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SUBMITTED",
        "CONFIRMED"
      ],
      "default": "PENDING"
    },
    "base_cost": {
      "type": "number",
      "default": 0
    },
    "markup_percentage": {
      "type": "number",
      "default": 0.3
    },
    "final_package_price": {
      "type": "number",
      "default": 0
    },
    "profit": {
      "type": "number",
      "default": 0
    },
    "deposit_option": {
      "type": "string",
      "enum": [
        "Full",
        "25%",
        "50%"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "25% Paid",
        "50% Paid",
        "Paid In Full",
        "Failed",
        "Refunded"
      ],
      "default": "Pending"
    },
    "consultation_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "consultation_fee_amount": {
      "type": "number",
      "default": 49
    },
    "consultation_credit_applied": {
      "type": "boolean",
      "default": false
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "amount_remaining": {
      "type": "number",
      "default": 0
    },
    "next_payment_due": {
      "type": "string",
      "format": "date"
    },
    "stripe_payment_id": {
      "type": "string"
    },
    "proposal_token": {
      "type": "string"
    },
    "proposal_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "itinerary_sent": {
      "type": "boolean",
      "default": false
    },
    "travel_confirmed": {
      "type": "boolean",
      "default": false
    },
    "transfer_confirmed": {
      "type": "boolean",
      "default": false
    },
    "final_confirmation_sent": {
      "type": "boolean",
      "default": false
    },
    "admin_notes": {
      "type": "string"
    },
    "timeline_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "signature_data": {
      "type": "string"
    },
    "signature_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "signature_ip_address": {
      "type": "string"
    },
    "accepted_arbitration_clause": {
      "type": "boolean",
      "default": false
    },
    "informed_consent_email_html": {
      "type": "string"
    },
    "informed_consent_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "cultural_care_package": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "origin_country": {
          "type": "string"
        },
        "procedure_category": {
          "type": "string"
        },
        "translation_routing": {
          "type": "object",
          "properties": {
            "language_primary": {
              "type": "string"
            },
            "language_secondary": {
              "type": "string"
            },
            "companion_type": {
              "type": "string"
            },
            "routing_instructions": {
              "type": "string"
            },
            "cultural_liaison_required": {
              "type": "boolean"
            }
          }
        },
        "diet_order": {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string"
            },
            "caloric_target_kcal": {
              "type": "number"
            },
            "meals": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cultural_notes": {
              "type": "string"
            }
          }
        },
        "logistics_notes": {
          "type": "string"
        }
      }
    },
    "notification_blackout_active": {
      "type": "boolean",
      "default": false
    },
    "notification_blackout_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "notification_blackout_lifted_at": {
      "type": "string",
      "format": "date-time"
    },
    "intake_handshake_logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "intake_handshake_logged_by": {
      "type": "string"
    },
    "procedure_complete_logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "fallback_state": {
      "type": "object",
      "description": "In-flux routing state when a primary partner misses their confirmation window",
      "properties": {
        "in_flux": {
          "type": "boolean",
          "default": false
        },
        "in_flux_triggered_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "primary_partner_type": {
          "type": "string",
          "enum": [
            "doctor",
            "taxi_service",
            "travel_agency"
          ]
        },
        "primary_partner_id": {
          "type": "string"
        },
        "primary_partner_name": {
          "type": "string"
        },
        "primary_partner_contact_phone": {
          "type": "string"
        },
        "confirmation_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "current_escalation_level": {
          "type": "number",
          "default": 1
        },
        "escalation_reason": {
          "type": "string",
          "enum": [
            "DOCTOR_MISSED_CONFIRMATION_WINDOW",
            "TRANSFER_MISSED_WINDOW",
            "BACKUP_A_DECLINED",
            "BACKUP_B_TIMEOUT",
            "MANUAL_ESCALATION"
          ]
        },
        "human_intervention_required": {
          "type": "boolean",
          "default": false
        },
        "human_intervention_triggered_at": {
          "type": "string",
          "format": "date-time"
        },
        "human_intervention_triggered_by": {
          "type": "string"
        },
        "fallback_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rank": {
                "type": "number"
              },
              "partner_id": {
                "type": "string"
              },
              "partner_name": {
                "type": "string"
              },
              "partner_type": {
                "type": "string"
              },
              "dispatch_phone": {
                "type": "string"
              },
              "clinical_director_phone": {
                "type": "string"
              },
              "confirmation_status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "CONFIRMED",
                  "DECLINED",
                  "TIMED_OUT"
                ],
                "default": "PENDING"
              },
              "notified_at": {
                "type": "string",
                "format": "date-time"
              },
              "confirmation_deadline": {
                "type": "string",
                "format": "date-time"
              },
              "confirmed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "audit_trail": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "requires_companion": {
      "type": "boolean",
      "default": false,
      "description": "True if patient requires a travel companion (age, SAFE-T, or admin-determined)"
    },
    "companion_requirement_reason": {
      "type": "string",
      "enum": [
        "age_threshold",
        "safe_t_flag",
        "medical_complexity",
        "patient_request",
        "admin_determined"
      ],
      "description": "Why companion is required"
    },
    "companion_requirement_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "assigned",
        "companion_declined_with_waiver",
        "companion_required_pending"
      ],
      "default": "not_required"
    },
    "companion_assignment_id": {
      "type": "string",
      "description": "Reference to CompanionAssignment entity"
    },
    "waiver_status": {
      "type": "string",
      "enum": [
        "not_required",
        "required",
        "sent",
        "signed",
        "refused",
        "expired",
        "admin_reissued"
      ],
      "default": "not_required"
    },
    "waiver_request_id": {
      "type": "string",
      "description": "Reference to WaiverRequest entity"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Patient date of birth for age-based companion check"
    },
    "dietary_profile_id": {
      "type": "string",
      "description": "Reference to DietaryProfile entity"
    },
    "linguistic_profile_id": {
      "type": "string",
      "description": "Reference to LinguisticProfile entity"
    },
    "clinical_boundary_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "clinical_boundary_acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "clinical_boundary_version": {
      "type": "string",
      "default": "1.0"
    },

    // ── Partner Quota Tracking ────────────────────────────────────────────────
    "quotas_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When quota requests were sent to all 4 partners"
    },
    "companion_cost": {
      "type": "number",
      "default": 0,
      "description": "Companion service cost submitted by companion partner"
    },
    "companion_quote_status": {
      "type": "string",
      "enum": ["PENDING", "SUBMITTED", "CONFIRMED"],
      "default": "PENDING"
    },
    "clinic_cost": {
      "type": "number",
      "default": 0,
      "description": "Clinic/facility fee submitted by the assigned clinic"
    },
    "clinic_quote_status": {
      "type": "string",
      "enum": ["PENDING", "SUBMITTED", "CONFIRMED"],
      "default": "PENDING"
    },
    "all_quotas_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True when all 4 partner quotas (travel, driver, companion, clinic) are confirmed"
    },

    // ── Package Pricing (post-quota calculation) ──────────────────────────────
    "package_price_full": {
      "type": "number",
      "default": 0,
      "description": "(base_cost - 49) * 1.25 — full payment price"
    },
    "package_price_terms": {
      "type": "number",
      "default": 0,
      "description": "(base_cost - 49) * 1.30 — price when paying in two installments"
    },
    "package_price_first_installment": {
      "type": "number",
      "default": 0,
      "description": "package_price_terms * 0.50 — the 50% upfront amount"
    },
    "payment_type": {
      "type": "string",
      "enum": ["full_pay", "terms"],
      "description": "Patient's chosen payment method"
    },
    "pay_now_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Pay Now email was sent to the patient"
    },

    // ── Partner Cascade Tracking ──────────────────────────────────────────────
    "doctor_cascade_sent": {
      "type": "boolean",
      "default": false
    },
    "travel_cascade_sent": {
      "type": "boolean",
      "default": false
    },
    "driver_cascade_sent": {
      "type": "boolean",
      "default": false
    },
    "companion_cascade_sent": {
      "type": "boolean",
      "default": false
    },

    // ── Payment Reminder Tracking ─────────────────────────────────────────────
    "payment_reminder_7d_sent": {
      "type": "boolean",
      "default": false
    },
    "payment_reminder_3d_sent": {
      "type": "boolean",
      "default": false
    },
    "payment_reminder_1d_sent": {
      "type": "boolean",
      "default": false
    },

    // ── Receipt Storage ───────────────────────────────────────────────────────
    "receipt_vault_id": {
      "type": "string",
      "description": "PassportVault record ID where the payment receipt is stored"
    },
    "receipt_html": {
      "type": "string",
      "description": "HTML content of the most recent payment receipt"
    },

    // ── Travel Date ───────────────────────────────────────────────────────────
    "departure_date": {
      "type": "string",
      "format": "date",
      "description": "Patient departure date (ISO date) — synced from Consultation.preferred_date"
    },
    "procedure_date": {
      "type": "string",
      "format": "date",
      "description": "Actual procedure/appointment date at destination"
    },
    "booking_type": {
      "type": "string",
      "enum": ["medical_package", "travel_only"],
      "default": "medical_package",
      "description": "medical_package = full medical tourism; travel_only = flight+hotel+taxi only"
    },

    // ── Pre-Travel Countdown Reminders ────────────────────────────────────────
    "travel_reminder_14d_sent": { "type": "boolean", "default": false },
    "travel_reminder_7d_sent":  { "type": "boolean", "default": false },
    "travel_reminder_3d_sent":  { "type": "boolean", "default": false },
    "travel_reminder_1d_sent":  { "type": "boolean", "default": false },
    "travel_reminder_day_of_sent": { "type": "boolean", "default": false },

    // ── Abandoned Booking Recovery (Expedia model) ────────────────────────────
    "abandoned_1_sent":   { "type": "boolean", "default": false, "description": "2-hr warm recovery email+SMS sent" },
    "abandoned_2_sent":   { "type": "boolean", "default": false, "description": "24-hr firm reminder email+SMS sent" },
    "quotas_released_at": { "type": "string",  "format": "date-time", "description": "When 48-hr quote expiry was triggered" },

    // ── Partner SLA Breach Tracking (Uber model) ──────────────────────────────
    "sla_breached_travel":    { "type": "boolean", "default": false },
    "sla_breached_driver":    { "type": "boolean", "default": false },
    "sla_breached_companion": { "type": "boolean", "default": false },
    "sla_breached_clinic":    { "type": "boolean", "default": false },
    "backup_travel_id":       { "type": "string", "description": "Backup travel agency dispatched after SLA breach" },
    "backup_driver_id":       { "type": "string", "description": "Backup driver dispatched after SLA breach" },

    // ── Stripe 1-Click Checkout (Stripe model) ────────────────────────────────
    "stripe_customer_id":     { "type": "string", "description": "Stripe Customer ID — enables 1-click balance payment" },
    "stripe_payment_method_id":{ "type": "string", "description": "Saved Stripe payment method for 1-click" },
    "stripe_payment_method_last4": { "type": "string", "description": "Last 4 digits for display in Pay Now email" }
  },
  "required": [
    "client_name",
    "client_email",
    "procedures"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.doctor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.doctor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
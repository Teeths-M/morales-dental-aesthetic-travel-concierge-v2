{
  "name": "DestinationDriver",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [

{
  "name": "TravelAgency",
  "type": "object",
  "properties": {
    "agency_name": {
      "type": "string",
      "description": "Name of the travel agency"
    },
    "name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "headquarters_country": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "medical_travel_experience_years": {
      "type": "number",
      "default": 0
    },
    "emergency_support_available": {
      "type": "boolean",
      "default": false
    },
    "service_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_options": {
      "type": "object"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "wipay"
      ]
    },
    "payout_account": {
      "type": "string"
    },
    "business_license_url": {
      "type": "string"
    },
    "language_preference": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "pt",
        "de",
        "it"
      ],
      "default": "en"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "active",
        "inactive"
      ],
      "default": "pending_verification"
    },
    "sign_up_completed_at": {
      "type": "string"
    },
    "approved_by_admin": {
      "type": "boolean",
      "default": false
    },
    "earnings_this_month": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 5.0
    },
    "token": {
      "type": "string"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email"
  ]
}
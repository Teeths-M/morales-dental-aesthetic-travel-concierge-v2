{
  "name": "TravelAgency",
  "type": "object",
  "properties": {
    "agency_name": {
      "type": "string",
      "description": "Name of the travel agency"
    },
    "contact_person": {
      "type": "string",
      "description": "Primary contact person"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number for the agency"
    },
    "website_url": {
      "type": "string"
    },
    "headquarters_country": {
      "type": "string"
    },
    "headquarters_city": {
      "type": "string",
      "description": "City of the agency's headquarters. Filtered to the selected headquarters_country in the signup UI."
    },
    "medical_travel_experience_years": {
      "type": "number",
      "default": 0
    },
    "emergency_support_available": {
      "type": "boolean",
      "default": false
    },
    "service_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Geographic regions served"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_options": {
      "type": "object",
      "description": "Detailed options per service"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "wipay"
      ]
    },
    "payout_account": {
      "type": "string"
    },
    "business_license_url": {
      "type": "string"
    },
    "language_preference": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "pt",
        "de",
        "it"
      ],
      "default": "en"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verifying",
        "verified",
        "failed",
        "manually_approved",
        "pending_manual",
        "rejected"
      ],
      "default": "pending_verification",
      "description": "Overall verification state (blocks 'active' status)"
    },
    "identity_verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "manual_override"
      ],
      "default": "pending"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "manual_override"
      ],
      "default": "pending"
    },
    "license_verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "manual_override"
      ],
      "default": "pending"
    },
    "verification_can_be_activated": {
      "type": "boolean",
      "description": "Computed: true only if all three checks are passed OR manually overridden",
      "default": false
    },
    "iata_code": {
      "type": "string",
      "description": "IATA numeric code (7-8 digits passenger, 11 cargo, 10 ID card). Collected conversationally by M-Care."
    },
    "iata_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only after reviewTravelAgencyVerification re-confirms the code against the IATA CheckACode API."
    },
    "iata_verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "valid",
        "not_listed",
        "format_invalid",
        "error"
      ],
      "default": "pending",
      "description": "Result of the real-time IATA CheckACode lookup."
    },
    "iata_raw_response": {
      "type": "object",
      "description": "Raw IATA CheckACode response, retained for audit."
    },
    "ai_decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED",
        "ESCALATED"
      ],
      "description": "M-Care's conversational decision after IATA + website checks."
    },
    "ai_reasoning": {
      "type": "string",
      "description": "M-Care's plain-English explanation for its approve/reject/escalate decision."
    },
    "onboarding_conversation_id": {
      "type": "string",
      "description": "References the M-Care agent conversation that onboarded this agency."
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When M-Care (or an admin) approved the agency."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "active",
        "inactive"
      ],
      "default": "pending_verification"
    },
    "sign_up_completed_at": {
      "type": "string",
      "description": "ISO timestamp"
    },
    "approved_by_admin": {
      "type": "boolean",
      "default": false
    },
    "earnings_this_month": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 5.0
    }
  },
  "required": [
    "agency_name",
    "email",
    "phone",
    "headquarters_country",
    "service_regions"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}
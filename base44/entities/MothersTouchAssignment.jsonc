{
  "name": "MothersTouchAssignment",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "companion_id": {
      "type": "string"
    },
    "companion_name": {
      "type": "string"
    },
    "companion_whatsapp": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_email": {
      "type": "string",
      "format": "email"
    },
    "lodging_address": {
      "type": "string"
    },
    "dietary_parameters": {
      "type": "string",
      "description": "Dietary restrictions, allergies, caloric targets"
    },
    "service_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "1-3 day service window"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "active",
        "checkout_pending",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "care_baseline_fee_usd": {
      "type": "number",
      "default": 40
    },
    "grocery_budget_usd": {
      "type": "number",
      "default": 0
    },
    "travel_flat_fee_usd": {
      "type": "number",
      "default": 10
    },
    "premium_addons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "price_usd": {
            "type": "number"
          }
        }
      }
    },
    "platform_commission_rate": {
      "type": "number",
      "default": 0.175,
      "description": "15-20% on care fee only"
    },
    "platform_commission_usd": {
      "type": "number",
      "default": 0
    },
    "companion_net_care_fee_usd": {
      "type": "number",
      "default": 0
    },
    "total_due_client_usd": {
      "type": "number",
      "default": 0
    },
    "grocery_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_url": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "client_checkout_confirmed": {
      "type": "boolean",
      "default": false
    },
    "client_checkout_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "companion_paid_out": {
      "type": "boolean",
      "default": false
    },
    "companion_paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "case_id",
    "companion_id",
    "patient_name",
    "patient_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "companion"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}

{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "doctor",
        "travel_agency",
        "driver_origin",
        "driver_destination",
        "client"
      ],
      "default": "client"
    },
    // Answered on first sign-in. Morales protects people who travel for
    // treatment AND people who do not — the safety layer (SOS, emergency
    // contacts, PIN vault) is not journey-dependent. This branches onboarding
    // and lets the rest of the platform stop assuming a trip exists.
    // localStorage mirrors it for instant/offline gating; this is the durable copy.
    "protection_type": {
      "type": "string",
      "enum": [
        "medical_traveler",
        "non_traveler"
      ],
      "description": "Whether this person is travelling for treatment or wants protection only"
    },
    "protection_type_set_at": {
      "type": "string",
      "format": "date-time"
    },
    "account_deletion_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when this account's data was anonymized (self-service deletion or admin GDPR erasure). AuthContext treats any non-null value as a forced-logout signal. Never cleared — deletion is instant/non-reversible."
    }
  }
}
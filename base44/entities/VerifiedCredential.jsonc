{
  "name": "VerifiedCredential",
  "type": "object",
  "description": "An immutable, hash-chained record of a partner's verified credential (medical license, IATA code, insurance, accreditation, identity doc). Each record stores a SHA-256 credential_hash of the canonical credential data plus a prev_credential_hash pointing at the previous VerifiedCredential for the same partner \u2014 forming a tamper-evident per-partner chain (GENESIS for the first). M-Care mints a record the moment a real verification tool confirms a credential (runDoctorVerificationScan approved, verifyIATACode valid, document-intelligence authentic). verifyCredentialChain re-walks the chain and reports any break. Distinct from AuditLog (platform-wide event chain) \u2014 this is the partner-credential-specific immutable store the 'upload once, verify immutably' loop writes to.",
  "properties": {
    "partner_type": {
      "type": "string",
      "enum": [
        "doctor",
        "clinic",
        "travel_agency",
        "taxi",
        "security",
        "companion"
      ]
    },
    "partner_id": {
      "type": "string",
      "description": "The id of the partner entity this credential belongs to."
    },
    "partner_name": {
      "type": "string"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "license",
        "iata_code",
        "insurance",
        "accreditation",
        "identity",
        "business_registration",
        "other"
      ]
    },
    "credential_reference": {
      "type": "string",
      "description": "The canonical identifier \u2014 license number, IATA code, accreditation id, etc."
    },
    "file_url": {
      "type": "string",
      "description": "Optional vaulted document URL backing the credential."
    },
    "credential_hash": {
      "type": "string",
      "description": "SHA-256 hex of the canonical credential payload (partner_id|credential_type|credential_reference|verified_at|verified_by)."
    },
    "prev_credential_hash": {
      "type": "string",
      "description": "credential_hash of the previous VerifiedCredential record for this same partner \u2014 forms the chain. 'GENESIS' for the first record."
    },
    "chain_index": {
      "type": "number",
      "default": 0,
      "description": "0-based position in this partner's chain."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string",
      "description": "What confirmed it \u2014 runDoctorVerificationScan, verifyIATACode, analyzeDocumentIntelligence, admin_manual."
    },
    "verification_source": {
      "type": "string",
      "enum": [
        "registry",
        "document_intelligence",
        "admin_manual",
        "iata_api",
        "background_check"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "revoked",
        "expired"
      ],
      "default": "valid"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_immutable": {
      "type": "boolean",
      "default": true,
      "description": "True once minted \u2014 the record should never be edited; revoke by minting a new status record, not by mutating."
    }
  },
  "required": [
    "partner_type",
    "partner_id",
    "credential_type",
    "credential_reference",
    "credential_hash",
    "prev_credential_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "authenticated": true
      }
    },
    "create": {
      "user_condition": {
        "authenticated": true
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "platform_admin"
      }
    }
  }
}
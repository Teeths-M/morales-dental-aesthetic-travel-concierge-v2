{
  "name": "PilotSignup",
  "type": "object",
  "description": "One person asking to join the Morales pilot. Deliberately minimal: an email address and where they asked from. No name, no phone, no procedure, no clinical detail is collected on a public marketing page \u2014 the pilot list exists to invite someone to a conversation later, so it should hold nothing that would matter if it leaked. Writes happen only through the joinPilot backend function as service role, which validates and de-duplicates; the create rule is closed so a client cannot bypass that. Admin-only reads.",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Normalised to lowercase before storing, so the same person asking twice is recognised as one signup."
    },
    "source": {
      "type": "string",
      "enum": [
        "landing_hero",
        "landing_greeting",
        "pilot_page"
      ],
      "default": "pilot_page",
      "description": "Which surface the person asked from \u2014 useful for knowing whether the greeting helps or just interrupts."
    },
    "campaign": {
      "type": "string",
      "description": "Which ad, card or post the person scanned: the ?src= tag on the /pilot link (for example ad29 or card). Short tag only, so the waiting list shows which ad actually brings people in."
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "invited",
        "joined",
        "declined"
      ],
      "default": "waiting"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "description": "Care-team only."
    }
  },
  "required": [
    "email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": false,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
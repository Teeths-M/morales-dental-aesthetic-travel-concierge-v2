{
  "name": "PilotSignup",
  "type": "object",
  "description": "A request to join the M-care pilot from the public marketing page. Two fields and nothing else, deliberately: where the person is going, and an address to reply to. Created by anyone, readable only by the care team \u2014 a person handing over their travel plans expects that to stay with the company that asked for it.",
  "properties": {
    "destination": {
      "type": "string",
      "description": "Where they are going, exactly as typed. Kept free text because a pilot applicant may not know the country name for the place they mean."
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "source": {
      "type": "string",
      "description": "Which surface the signup came from, so a second form later never silently mixes with this one.",
      "default": "pilot_page"
    }
  },
  "required": [
    "destination",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
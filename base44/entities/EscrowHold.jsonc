{
  "name": "EscrowHold",
  "type": "object",
  "description": "Airbnb-model escrow: partner funds are held here until the patient completes the corresponding handshake, then auto-released 24 hours later.",
  "properties": {
    "case_id":         { "type": "string" },
    "partner_type":    { "type": "string", "enum": ["doctor", "driver_origin", "driver_destination", "companion", "travel_agency"] },
    "partner_id":      { "type": "string" },
    "partner_email":   { "type": "string" },
    "partner_name":    { "type": "string" },
    "amount_held_usd": { "type": "number", "default": 0, "description": "USD amount held in escrow for this partner" },
    "release_trigger_hs": { "type": "number", "description": "Handshake number that triggers the 24-hour release countdown (e.g. 5 for Doctor)" },
    "status": {
      "type": "string",
      "enum": ["held", "releasing", "released", "disputed", "cancelled", "refunded"],
      "default": "held"
    },
    "payment_confirmed_at":   { "type": "string", "format": "date-time", "description": "When patient payment was captured" },
    "trigger_confirmed_at":   { "type": "string", "format": "date-time", "description": "When the release-trigger handshake was completed" },
    "release_scheduled_at":   { "type": "string", "format": "date-time", "description": "24 hours after trigger — when funds are released" },
    "released_at":            { "type": "string", "format": "date-time" },
    "stripe_transfer_id":     { "type": "string", "description": "Stripe Transfer ID once payout is issued" },
    "stripe_connected_account": { "type": "string", "description": "Partner's Stripe Connect account ID" },
    "release_notes":          { "type": "string" },
    "refunded_at":            { "type": "string", "format": "date-time", "description": "Set by cancelBooking when a held (un-released) amount is refunded to the patient" },
    "refund_reason":          { "type": "string" }
  },
  "required": ["case_id", "partner_type", "amount_held_usd", "release_trigger_hs"],
  "rls": {
    "read":   { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "platform_admin" } }
  }
}

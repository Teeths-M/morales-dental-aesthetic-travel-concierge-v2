{
  "name": "ConsultationFee",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "procedure": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "consultation_fee_amount": {
      "type": "number",
      "default": 49
    },
    "fee_paid": {
      "type": "boolean",
      "default": false
    },
    "fee_paid_at": {
      "type": "string",
      "description": "ISO timestamp"
    },
    "fee_refunded": {
      "type": "boolean",
      "default": false
    },
    "refund_method": {
      "type": "string",
      "enum": [
        "deducted_from_package",
        "stripe_refund",
        "none"
      ],
      "description": "How was the $49 refunded?"
    },
    "package_booking_id": {
      "type": "string",
      "description": "Link to actual procedure booking if made"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded",
        "forfeited"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes \u2014 used for demo/legacy tagging, audit flags, etc."
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record was created by pre-production demo payment logic"
    },
    "exclude_from_revenue_reporting": {
      "type": "boolean",
      "default": false,
      "description": "True if this record should be excluded from revenue calculations"
    }
  },
  "required": [
    "email",
    "procedure",
    "destination"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "VaultPIN",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "pin_hash": {
      "type": "string",
      "description": "PBKDF2-SHA256 hash of the 4-digit PIN. Always hashed at the count stored in `iterations` on this same record -- never assume a fixed global value here."
    },
    "pin_salt": {
      "type": "string",
      "description": "Base64 encoded salt for PBKDF2 - derived from user email"
    },
    "iterations": {
      "type": "number",
      "description": "The exact PBKDF2 iteration count pin_hash was computed with. Self-describing so a future platform/strength change only affects new PINs, never silently breaks verification of existing ones -- see base44/shared/pinHashing.ts. A record with no value here predates this field and cannot be verified on this runtime (the historical 600,000 value exceeds this platform's PBKDF2 cap) -- the user must reset."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "failed_attempts": {
      "type": "number",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "pin_hash"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
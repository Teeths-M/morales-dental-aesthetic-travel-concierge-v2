{
  "name": "Provider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Professional title"
    },
    "specialty": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "review_count": {
      "type": "number"
    },
    "bio": {
      "type": "string"
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expertise_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "title",
    "specialty"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
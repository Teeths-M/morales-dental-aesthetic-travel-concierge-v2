{
  "name": "McareKnowledge",
  "type": "object",
  "description": "M-Care's learn-and-recall brain. When M-Care is stuck or unsure of an answer, it researches the question (web + reasoning), and if the answer is rated at least 80% accurate it persists the Q&A here so future identical or similar questions can be answered instantly from memory instead of re-researching. Admins curate it; the agent reads and writes it via its tool set.",
  "properties": {
    "question": {
      "type": "string",
      "description": "The original traveler/partner question, as asked"
    },
    "normalized_question": {
      "type": "string",
      "description": "Lowercased, punctuation-stripped question used for keyword matching on recall"
    },
    "answer": {
      "type": "string",
      "description": "The researched, >=80%-accurate answer M-Care can reuse"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Model-reported confidence/accuracy estimate 0-100. Records are only created when this is >= 80"
    },
    "accuracy_estimation": {
      "type": "string",
      "description": "How the model assessed accuracy (e.g. cross-checked against multiple sources, registry-confirmed, well-established fact)"
    },
    "source_summary": {
      "type": "string",
      "description": "Brief note on the sources/reasoning behind the answer"
    },
    "search_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords extracted from the question to power fuzzy recall matching"
    },
    "journey_context": {
      "type": "string",
      "enum": [
        "medical",
        "travel",
        "logistics",
        "verification",
        "safety",
        "general"
      ],
      "default": "general"
    },
    "recalled_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this answer has been recalled for a future question"
    },
    "useful_feedback": {
      "type": "number",
      "default": 0,
      "description": "Net upvotes confirming the answer helped (admin/agent can increment)"
    },
    "flagged_for_review": {
      "type": "boolean",
      "default": false,
      "description": "Admin flagged this entry as inaccurate or outdated so recall skips it until fixed"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "description": "Email of the authenticated user whose session learned this, or 'mcare_agent' for an anonymous session"
    },
    "source_url": {
      "type": "string",
      "description": "The real URL of the top web source used to research this answer, when one exists (e.g. the top Tavily result). Never fabricated or guessed — empty when no real source URL is available."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "tavily_web_search",
        "llm_grounding",
        "self_observed_pattern",
        "admin_curated"
      ],
      "description": "How this fact was actually obtained: a real Tavily web search, Base44's black-box add_context_from_internet grounding flag, a deterministic pattern computed from real JourneyPlan execution history (analyzeMcarePerformance), or a human admin edit. Orthogonal to confidence_score — this says HOW, not HOW SURE."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "researched",
        "corroborated",
        "stale",
        "conflicted",
        "retracted"
      ],
      "default": "researched",
      "description": "Epistemic status of this fact. Deliberately has NO 'verified' value — there is no authoritative registry for most of what this cache holds, so nothing here may ever claim that. 'researched' = one research pass cleared the >=80% confidence bar. 'corroborated' = a second, independent research pass at a later time reached the same conclusion. 'stale' = due for review and a revalidation attempt did not confirm it. 'conflicted' = a later research pass disagreed with this answer; a human review is pending. 'retracted' = an admin flagged this entry (kept in sync with flagged_for_review)."
    },
    "freshness_tier": {
      "type": "string",
      "enum": [
        "volatile",
        "regulatory",
        "stable"
      ],
      "default": "stable",
      "description": "How quickly this kind of fact tends to change, driving which TTL_MS.knowledge_* window applies (see base44/shared/freshness.ts). 'volatile' = prices/availability/current-conditions-shaped facts. 'regulatory' = visa/licensing/travel-restriction-shaped facts. 'stable' = general procedure/terminology/definition-shaped facts. Provider-specific facts (a specific doctor's/driver's own status) do not belong in this generic cache at all — they live on that provider's own entity."
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this fact was last confirmed correct, either at initial research or by a later successful revalidation. Compared against freshness_tier's TTL via freshnessState() to decide whether a recall can be trusted as-is."
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time",
      "description": "last_verified_at plus this fact's freshness_tier TTL window — informational; the actual freshness check is always computed live from last_verified_at, this field is never itself the source of truth."
    },
    "jurisdiction": {
      "type": "string",
      "description": "The broader jurisdiction this fact applies to (e.g. 'Federal / United States', 'European Union'), when the fact is jurisdiction-specific. Left blank when not applicable — never guessed."
    },
    "country": {
      "type": "string",
      "description": "The specific country this fact applies to, when it is country-specific. Left blank when the fact is general/global — never guessed."
    }
  },
  "required": [
    "question",
    "answer",
    "confidence_score"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "authenticated": true
      }
    },
    "create": {
      "user_condition": {
        "authenticated": true
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}
{
  "name": "TripAssistancePolicy",
  "type": "object",
  "description": "One trip's rules for asking for help: how many requests are allowed, when it is quiet, which languages are on file, and how long anything is kept. Created at booking, never by a client \u2014 every field here is a limit the server enforces, so a traveller cannot raise their own allowance and a care-team member cannot quietly ignore quiet hours without the override being recorded on the request itself. automated_voice_enabled exists and must stay false in this release: there is no voice provider, and a policy row that claimed otherwise would be a promise the product cannot keep.",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "patient_email": {
      "type": "string",
      "format": "email",
      "description": "Denormalised for RLS \u2014 the traveller reads their own policy."
    },
    "trip_language": {
      "type": "string",
      "enum": [
        "es",
        "pt",
        "fr",
        "it",
        "de",
        "en"
      ],
      "default": "en",
      "description": "Trip-country language. Scripts are composed in this first, with the English wording stored alongside."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the care team can actually answer in, shown on the trip screen before a request is written."
    },
    "local_number": {
      "type": "string",
      "description": "The trip-country M-Care number that answers at 3am. Printed on the show-this-screen card."
    },
    "local_number_label": {
      "type": "string"
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": true
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "HH:MM in the trip's own timezone."
    },
    "quiet_hours_end": {
      "type": "string"
    },
    "quiet_hours_timezone": {
      "type": "string",
      "description": "IANA zone for the destination. Quiet hours are trip-local, never the traveller's home clock."
    },
    "per_trip_cap": {
      "type": "number",
      "default": 6,
      "description": "Requests allowed across the whole trip. Enforced server-side on every create."
    },
    "per_day_cap": {
      "type": "number",
      "default": 2
    },
    "retention_days_outcomes": {
      "type": "number",
      "default": 90,
      "description": "Structured outcomes and redacted summaries are kept until trip end plus this many days."
    },
    "retention_days_audio": {
      "type": "number",
      "default": 30,
      "description": "Call audio is purged after this, unless the call belongs to an incident, where incident retention governs."
    },
    "automated_voice_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Always false in this release. No automated call may be placed, and the backend refuses any path that would need it."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active"
    },
    "created_by_function": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "patient_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "platform_admin"
      }
    }
  }
}
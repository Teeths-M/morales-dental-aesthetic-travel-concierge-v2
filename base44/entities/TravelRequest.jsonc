{
  "name": "TravelRequest",
  "type": "object",
  "properties": {
    "request_token": {
      "type": "string",
      "description": "TRAVEL_<hex> - Unique reference token"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "user_name": {
      "type": "string"
    },
    "user_phone": {
      "type": "string"
    },
    "origin_city": {
      "type": "string"
    },
    "origin_country": {
      "type": "string"
    },
    "destination_city": {
      "type": "string"
    },
    "destination_country": {
      "type": "string"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "passport_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "travelers_count": {
      "type": "number",
      "default": 1
    },
    "travel_class": {
      "type": "string",
      "enum": [
        "economy",
        "premium_economy",
        "business",
        "first"
      ],
      "default": "economy"
    },
    "hotel_required": {
      "type": "boolean",
      "default": true
    },
    "hotel_star_rating": {
      "type": "number",
      "minimum": 3,
      "maximum": 5
    },
    "hotel_room_type": {
      "type": "string",
      "enum": [
        "standard",
        "deluxe",
        "suite",
        "penthouse"
      ]
    },
    "transfer_required": {
      "type": "boolean",
      "default": true
    },
    "transfer_type": {
      "type": "string",
      "enum": [
        "standard",
        "luxury",
        "vip"
      ],
      "default": "standard"
    },
    "companion_required": {
      "type": "boolean",
      "default": false
    },
    "companion_type": {
      "type": "string",
      "enum": [
        "tour_guide",
        "care_companion",
        "luxury_concierge"
      ]
    },
    "companion_days": {
      "type": "number",
      "default": 0
    },
    "package_status": {
      "type": "string",
      "enum": [
        "draft",
        "pricing_requested",
        "quote_sent",
        "deposit_paid",
        "fully_paid",
        "confirmed",
        "cancelled"
      ],
      "default": "draft"
    },
    "flight_cost": {
      "type": "number",
      "default": 0
    },
    "hotel_cost": {
      "type": "number",
      "default": 0
    },
    "transfer_cost": {
      "type": "number",
      "default": 0
    },
    "companion_cost": {
      "type": "number",
      "default": 0
    },
    "base_cost": {
      "type": "number",
      "default": 0
    },
    "markup_percentage": {
      "type": "number",
      "default": 0.25
    },
    "total_package_price": {
      "type": "number",
      "default": 0
    },
    "profit": {
      "type": "number",
      "default": 0
    },
    "deposit_percentage": {
      "type": "number",
      "default": 0.25
    },
    "deposit_amount": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "amount_remaining": {
      "type": "number",
      "default": 0
    },
    "stripe_payment_id": {
      "type": "string"
    },
    "travel_agency_id": {
      "type": "string"
    },
    "chauffeur_id": {
      "type": "string"
    },
    "companion_id": {
      "type": "string"
    },
    "special_requests": {
      "type": "string"
    },
    "quote_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "deposit_paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "fully_paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "flight_number": {
      "type": "string",
      "description": "IATA flight number, e.g. AA123 or TK45"
    },
    "scheduled_departure": {
      "type": "string",
      "format": "date-time",
      "description": "Original scheduled departure (UTC)"
    },
    "scheduled_arrival": {
      "type": "string",
      "format": "date-time",
      "description": "Original scheduled arrival (UTC)"
    },
    "flight_status": {
      "type": "string",
      "enum": [
        "scheduled",
        "delayed",
        "in_progress",
        "landed",
        "cancelled",
        "unknown"
      ],
      "default": "scheduled"
    },
    "delay_minutes": {
      "type": "number",
      "default": 0,
      "description": "Positive = delayed; 0 = on time; negative = early"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "Last time checkFlightStatus polled this record"
    },
    "arrival_terminal": {
      "type": "string"
    },
    "arrival_gate": {
      "type": "string"
    },
    "driver_name": {
      "type": "string",
      "description": "Display name of assigned pickup driver"
    },
    "driver_photo_url": {
      "type": "string",
      "description": "URL for driver headshot shown on WelcomeScreen"
    },
    "welcome_cached_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when offline welcome payload was pre-built (at in_progress status)"
    },
    "paused": {
      "type": "boolean",
      "default": false,
      "description": "True while the journey is paused. All outbound notifications are suppressed while this is true."
    },
    "paused_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the journey was last paused"
    },
    "pause_reason": {
      "type": "string",
      "description": "Patient-supplied reason for pausing (e.g. 'resting', 'family emergency')"
    },
    "resumed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the journey was last resumed"
    },
    "handshake_status": {
      "type": "object",
      "description": "Completed flags per step — keys '1' through '9', values true/false",
      "default": {}
    },
    "handshake_timestamps": {
      "type": "object",
      "description": "ISO timestamps per completed step — keys '1' through '9'",
      "default": {}
    },
    "trip_phase": {
      "type": "string",
      "enum": [
        "pre_departure",
        "transit_out",
        "arrived",
        "recovery",
        "transit_return",
        "completed"
      ],
      "default": "pre_departure",
      "description": "Current physical phase of the journey, derived from current_step"
    },
    "current_step": {
      "type": "number",
      "default": 0,
      "description": "Last confirmed handshake number (0 = none started, 9 = journey complete)"
    },
    "case_id": {
      "type": "string",
      "description": "Linked CaseRecord.id — read/written by completeHandshake and escalateMissedDriverHandshake; was undeclared here despite being live-written since this entity's creation."
    },
    "noshow_flagged_steps": {
      "type": "array",
      "items": { "type": "number" },
      "default": [],
      "description": "Handshake step numbers (1-9) escalateMissedDriverHandshake has already dispatched a backup driver for — prevents redispatching every 15 min on the same missed step."
    }
  },
  "required": [
    "request_token",
    "user_email",
    "origin_city",
    "destination_city",
    "departure_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
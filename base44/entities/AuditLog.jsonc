{
  "name": "AuditLog",
  "type": "object",
  "description": "The platform-wide, tamper-evident hash-chained event ledger. Each entry stores a SHA-256 prev_hash pointing at the previous entry (GENESIS for the first). Used by TrustScan to audit every verification access \u2014 consent recorded, inquiry created/completed, evidence accessed, profile viewed, review created/decided, credential recheck failed, booking suspended/cleared, consent revoked, manual review requested. VerificationAuditLog is consolidated INTO this entity rather than duplicated as a parallel chain.",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "sensitive_profile_viewed",
        "passport_token_viewed",
        "passport_access_requested",
        "passport_access_approved",
        "passport_access_denied",
        "dietary_profile_updated",
        "allergy_profile_updated",
        "waiver_requested",
        "waiver_signed",
        "waiver_refused",
        "companion_required_flagged",
        "companion_assigned",
        "companion_handshake_completed",
        "companion_job_accepted",
        "companion_job_cancelled",
        "partner_notified",
        "partner_verification_approved",
        "partner_verification_rejected",
        "safet_risk_status_changed",
        "clinical_boundary_acknowledged",
        "handshake_created",
        "handshake_completed",
        "case_accessed",
        "role_escalation_attempt",
        "safe_t_critical_block",
        "safe_t_high_risk_waiver_signed",
        "emergency_pin_reset",
        "vault_pin_reset",
        "recovery_guidance_drafted",
        "recovery_guidance_approved",
        "recovery_guidance_rejected",
        "medication_reported",
        "medication_confirmed",
        "medication_flagged",
        "medication_discontinued",
        "doctor_nomination_submitted",
        "doctor_nomination_approved",
        "doctor_nomination_rejected",
        "doctor_nomination_outreach_sent",
        "doctor_nomination_opted_out",
        "outcome_memory_written",
        "memory_bank_recall_viewed",
        "gdpr_deletion",
        "account_deletion_requested",
        "account_deletion_completed",
        "mcare_stage_transition",
        "vault_document_scanned",
        "vault_document_verification_result",
        "vault_document_reviewed",
        "vault_document_accessed",
        "journey_plan_created",
        "journey_plan_step_updated",
        "journey_plan_completed",
        "virtual_consultation_booked",
        "virtual_consultation_consent_recorded",
        "virtual_consultation_joined",
        "virtual_consultation_plan_submitted",
        "provider_concern_reported",
        "provider_booking_suspended",
        "provider_booking_suspension_cleared",
        "medical_evidence_approved",
        "medical_evidence_rejected",
        "trustscan_consent_recorded",
        "trustscan_consent_revoked",
        "trustscan_inquiry_created",
        "trustscan_inquiry_completed",
        "trustscan_evidence_accessed",
        "trustscan_profile_viewed",
        "trustscan_review_created",
        "trustscan_review_decided",
        "trustscan_manual_review_requested",
        "trustscan_credential_recheck_failed",
        "trustscan_credential_recheck_scheduled",
        "trustscan_booking_suspended",
        "trustscan_booking_suspension_cleared",
        "trustscan_fraud_signal_recorded",
        "covert_sos_triggered",
        "covert_sos_evidence_captured",
        "covert_sos_evidence_accessed",
        "tier2_emergency_packet_assembled",
        "tier2_emergency_routed",
        "role_changed",
        "profile_updated",
        "contact_phone_changed",
        "guardian_access_granted",
        "safety_monitoring_paused",
        "safety_monitoring_resumed",
        "account_flag_cleared",
        "account_flag_locked",
        "all_quotas_confirmed_auto_pricing",
        "background_check_failed",
        "background_check_manual_override",
        "background_check_passed",
        "background_check_returned_to_queue",
        "booking_cancelled",
        "byoj_enrolled",
        "case_message_posted",
        "chauffeur_dispatched",
        "companion_expense_approved",
        "data_export",
        "discharge_paper_read",
        "doctor_activated",
        "doctor_quote_selected",
        "doctor_quote_submitted",
        "doctor_quotes_requested",
        "emergency_alert_triggered",
        "emergency_beacon_activated",
        "emergency_pin_failed",
        "emergency_threat_loop_closed",
        "escrow_payment_released",
        "flight_disruption",
        "fraud_intelligence_high_risk",
        "fraud_override_applied",
        "golden_m_notification_sent",
        "guardian_check_in_sent",
        "guardian_checkin_request",
        "guardian_escalation_critical",
        "guardian_soft_ping",
        "handshake_phone_mismatch",
        "handshake_sms_confirmed",
        "handshake_tap_confirmed",
        "home_safe_confirmed",
        "identity_check_failed",
        "identity_check_manual_override",
        "identity_check_passed",
        "identity_check_returned_to_queue",
        "intake_human_escalation",
        "license_check_failed",
        "license_check_manual_override",
        "license_check_passed",
        "license_check_returned_to_queue",
        "malicious_action_blocked",
        "medguard_analysis",
        "medication_schedule_sent",
        "package_price_calculated",
        "partner_activated",
        "partner_quotas_requested",
        "pattern_escalation",
        "pay_now_email_sent",
        "payment_cascade_triggered",
        "payment_receipt_issued",
        "post_op_checkin_notifications_sent",
        "post_op_checkin_submitted",
        "post_op_checkins_scheduled",
        "post_op_instructions_sent",
        "predictive_escalation_fired",
        "procedure_date_confirmed",
        "procedure_stacking_blocked",
        "recovery_anomaly_escalate",
        "recovery_anomaly_warning",
        "recovery_missed_checkin",
        "satellite_device_registered",
        "satellite_message_received",
        "satellite_sos_received",
        "share_token_generated",
        "trip_paused",
        "trip_resumed",
        "trip_timings_recalculated",
        "violation_scrubbed",
        "walkie_talkie_session_ended",
        "rescue_card_created",
        "rescue_card_replaced",
        "rescue_card_used",
        "checkin_code_set",
        "checkin_duress_code_used"
      ]
    },
    "actor_id": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "resource_type": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "resource_name": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "sensitive": {
      "type": "boolean",
      "default": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "prev_hash": {
      "type": "string",
      "description": "SHA-256 hash of the previous AuditLog entry \u2014 forms a tamper-evident hash chain. GENESIS for the first entry."
    }
  },
  "required": [
    "event_type",
    "actor_id",
    "timestamp"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.actor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "platform_admin"
      }
    }
  }
}
{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "sensitive_profile_viewed",
        "passport_token_viewed",
        "passport_access_requested",
        "passport_access_approved",
        "passport_access_denied",
        "dietary_profile_updated",
        "allergy_profile_updated",
        "waiver_requested",
        "waiver_signed",
        "waiver_refused",
        "companion_required_flagged",
        "companion_assigned",
        "companion_handshake_completed",
        "companion_job_accepted",
        "companion_job_cancelled",
        "partner_notified",
        "partner_verification_approved",
        "partner_verification_rejected",
        "safet_risk_status_changed",
        "clinical_boundary_acknowledged",
        "handshake_created",
        "handshake_completed",
        "case_accessed",
        "role_escalation_attempt",
        "safe_t_critical_block",
        "safe_t_high_risk_waiver_signed",
        "emergency_pin_reset",
        "vault_pin_reset",
        "recovery_guidance_drafted",
        "recovery_guidance_approved",
        "recovery_guidance_rejected",
        "doctor_nomination_submitted",
        "doctor_nomination_approved",
        "doctor_nomination_rejected",
        "doctor_nomination_outreach_sent",
        "doctor_nomination_opted_out",
        "outcome_memory_written",
        "memory_bank_recall_viewed",
        "gdpr_deletion",
        "account_deletion_requested",
        "account_deletion_completed",
        "mcare_stage_transition"
      ]
    },
    "actor_id": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "resource_type": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "resource_name": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "sensitive": {
      "type": "boolean",
      "default": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "prev_hash": {
      "type": "string",
      "description": "SHA-256 hash of the previous AuditLog entry \u2014 forms a tamper-evident hash chain. GENESIS for the first entry."
    }
  },
  "required": [
    "event_type",
    "actor_id",
    "timestamp"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.actor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "platform_admin"
      }
    }
  }
}
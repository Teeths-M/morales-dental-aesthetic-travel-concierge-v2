{
  "name": "ProcedureKnowledge",
  "type": "object",
  "description": "M-Care's structured medical-procedure safety knowledge base. Each record describes a common procedure (cosmetic, dental, orthopedic, bariatric, ophthalmology, fertility, general surgery, cardiac) with its risk level, recovery time, risk factors, complications, recommended surgeon qualifications, pre-op requirements, dangerous red-flag combinations, and the questions a patient should ask. M-Care reads this BEFORE discussing any procedure, asks for the traveler's medical background first, flags risks against that background, includes a non-diagnostic disclaimer, and guides the traveler to a safe next step (verified specialist / questions to ask). Admins curate it.",
  "properties": {
    "procedure_name": {
      "type": "string",
      "description": "Canonical procedure name, e.g. 'Brazilian Butt Lift (BBL)'"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternate / casual names users might say, e.g. 'butt lift', 'gluteal augmentation' \u2014 powers fuzzy lookup"
    },
    "category": {
      "type": "string",
      "enum": [
        "Cosmetic",
        "Dental",
        "Orthopedic",
        "Cardiac",
        "General Surgery",
        "Bariatric",
        "Ophthalmology",
        "Fertility",
        "ENT",
        "Other"
      ]
    },
    "description": {
      "type": "string",
      "description": "One-plain-English sentence on what the procedure is"
    },
    "typical_duration": {
      "type": "string",
      "description": "e.g. '2-4 hours'"
    },
    "recovery_time": {
      "type": "string",
      "description": "e.g. '7-14 days'"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Very High",
        "Not Yet Assessed"
      ],
      "description": "'Not Yet Assessed' is an honest placeholder for a record that only has an illustrative image, never a real level someone made up. getProcedureKnowledge and getProcedureRiskSummaries both exclude 'Not Yet Assessed' rows from their results \u2014 this value must never be narrated to a traveler as if it were a real clinical answer, and must never be treated as a genuine risk assessment by anything that reads this field."
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Patient factors that raise risk, e.g. 'Diabetes', 'Hypertension', 'Smoking', 'Obesity', 'Bleeding disorders'"
    },
    "complication_rate": {
      "type": "string",
      "description": "e.g. '1 in 500', 'About 2%'"
    },
    "common_complications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. 'Infection', 'Bleeding', 'Scarring', 'Fat embolism'"
    },
    "recommended_qualifications": {
      "type": "string",
      "description": "e.g. 'Board-certified plastic surgeon, accredited hospital with ICU'"
    },
    "pre_op_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. 'Blood work', 'Medical clearance', 'Fasting 8 hours', 'Stop smoking 6 weeks'"
    },
    "red_flag_combinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "combination": {
            "type": "string",
            "description": "e.g. 'BBL + large-volume liposuction'"
          },
          "severity": {
            "type": "string",
            "enum": [
              "High",
              "Very High",
              "Critical"
            ]
          },
          "requirement": {
            "type": "string",
            "description": "e.g. 'Requires board-certified plastic surgeon with BBL training and an accredited facility'"
          }
        }
      },
      "description": "Procedure or patient combinations that materially raise risk"
    },
    "smoker_warning": {
      "type": "string",
      "description": "Specific guidance for smokers (healing/infection risk + recommended quit window)"
    },
    "questions_to_ask": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The exact questions a patient should ask their surgeon before proceeding"
    },
    "image_url": {
      "type": "string",
      "description": "A real, already-generated illustrative diagram for this procedure (never a before/after, never a specific patient) \u2014 surfaced to M-Care's chat via getProcedureIllustration/RULE 22. Populated either by an admin directly or by the generateProcedureIllustrations batch tool."
    },
    "overview_what_it_is": {
      "type": "string",
      "description": "Plain-language explanation of what the procedure actually is, for the comprehensive M-Care education response (explainProcedure). General/population-level content, not a personalized risk claim."
    },
    "overview_recommended_for": {
      "type": "string",
      "description": "Who this procedure is typically recommended for, in general terms"
    },
    "overview_not_recommended_for": {
      "type": "string",
      "description": "Who this procedure is typically NOT recommended for, in general terms (this is separate from risk_level/red_flag_combinations \u2014 general population guidance, not a personalized flag)"
    },
    "what_happens_before": {
      "type": "string",
      "description": "What a patient typically experiences right before the procedure"
    },
    "what_happens_during": {
      "type": "string",
      "description": "What a patient typically experiences during the procedure"
    },
    "what_happens_after": {
      "type": "string",
      "description": "What a patient typically experiences immediately after the procedure"
    },
    "anesthesia_info": {
      "type": "string",
      "description": "Whether and what type of anesthesia/sedation is typically used, and what that generally feels like"
    },
    "room_time_typical": {
      "type": "string",
      "description": "Typical time spent in the procedure room / operating area, e.g. '45-90 minutes'"
    },
    "total_visit_time_typical": {
      "type": "string",
      "description": "Typical total visit duration including prep and recovery-room time, e.g. '3-4 hours'"
    },
    "success_satisfaction_range": {
      "type": "string",
      "description": "General, honestly-hedged success/satisfaction range, e.g. 'generally reported in the 85-95% range, varies by technique and provider'"
    },
    "side_effect_duration": {
      "type": "string",
      "description": "How long common side effects typically last"
    },
    "warning_signs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Warning signs during recovery that require immediate medical attention"
    },
    "activity_restrictions": {
      "type": "string",
      "description": "General activity restrictions during recovery (exercise, driving, work, etc.)"
    },
    "normal_life_resumes": {
      "type": "string",
      "description": "General guidance on when normal daily life typically resumes"
    },
    "pre_procedure_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "General pre-procedure do's (distinct from pre_op_requirements, which are the curated safety/clearance requirements)"
    },
    "post_procedure_dos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "General post-procedure do's \u2014 medication, diet, wound care, activity"
    },
    "post_procedure_donts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "General post-procedure don'ts"
    },
    "common_patient_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What patients commonly get wrong during recovery"
    },
    "main_benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main general benefits of the procedure"
    },
    "common_alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Common alternative treatments"
    },
    "alternative_guidance": {
      "type": "string",
      "description": "General guidance on when an alternative might be a better fit"
    },
    "education_source": {
      "type": "string",
      "enum": [
        "not_yet_generated",
        "ai_researched",
        "admin_curated"
      ],
      "default": "not_yet_generated",
      "description": "Provenance of the education_* fields above (everything from overview_what_it_is through alternative_guidance, plus questions_to_ask when filled by explainProcedure). 'ai_researched' rows were confidence-gated (>=80%) by explainProcedure and must always be narratable as researched general information, never as this database's own curated clinical authority. This field, and every field it governs, is structurally separate from risk_level/complication_rate/red_flag_combinations/smoker_warning/common_complications, which remain permanently admin-write-only \u2014 explainProcedure must never write those fields."
    },
    "education_confidence_score": {
      "type": "number",
      "description": "Self-reported confidence (0-100) from the research pass that generated the education_* fields, when education_source is 'ai_researched'. Null/absent for admin_curated or not_yet_generated rows."
    },
    "education_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the education_* fields were last generated or curated"
    },
    "education_uncertainty_notes": {
      "type": "string",
      "description": "Honest notes on what varies significantly by region, clinic, or technique for this procedure's education content \u2014 never a substitute for hedging language in the fields themselves"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive records are skipped by lookup so outdated entries don't surface"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "procedure_name",
    "category",
    "risk_level"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "authenticated": true
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}
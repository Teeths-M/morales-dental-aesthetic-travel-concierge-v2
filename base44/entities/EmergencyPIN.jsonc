{
  "name": "EmergencyPIN",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "pin_hash": {
      "type": "string",
      "description": "PBKDF2-SHA256 hash of the 6-digit PIN \u2014 never store plaintext. Always hashed at the count stored in `iterations` on this same record -- never assume a fixed global value here."
    },
    "iterations": {
      "type": "number",
      "description": "The exact PBKDF2 iteration count pin_hash was computed with. Self-describing so a future platform/strength change only affects new PINs, never silently breaks verification of existing ones -- see base44/shared/pinHashing.ts. A record with no value here predates this field; assumed to be the historical 200,000 value, which also exceeds this platform's PBKDF2 cap -- the user must reset."
    },
    "pin_hint": {
      "type": "string",
      "description": "Optional user-defined hint"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "use_count": {
      "type": "number",
      "default": 0
    },
    "failed_attempts": {
      "type": "number",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reset_token": {
      "type": "string"
    },
    "reset_token_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "pin_hash"
  ],
  "rls": {
    "read":   { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

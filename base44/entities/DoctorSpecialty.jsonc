{
  "name": "DoctorSpecialty",
  "type": "object",
  "properties": {
    "doctor_id": {
      "type": "string",
      "description": "Reference to Doctor"
    },
    "procedure_id": {
      "type": "string",
      "description": "Reference to MasterProcedure (e.g., DENT-IMP-01)"
    },
    "procedure_name": {
      "type": "string",
      "description": "Friendly name of procedure (auto-filled from MasterProcedure)"
    },
    "category": {
      "type": "string",
      "description": "Parent category (e.g., 'Dental', 'Orthopedics')"
    },
    "cpt_code": {
      "type": "string",
      "description": "CPT (Current Procedural Terminology) code if applicable"
    },
    "expertise_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "expert"
      ],
      "default": "intermediate"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Highlight as top specialty for this doctor"
    }
  },
  "required": [
    "doctor_id",
    "procedure_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.doctor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.doctor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
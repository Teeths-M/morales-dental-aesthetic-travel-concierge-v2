{
  "name": "SurroundingsSettings",
  "type": "object",
  "description": "One traveller's own rules for being interrupted about what is happening around them: whether the layer is on at all, the quietest level worth a notification, when not to be woken, and the last position they shared. This is a governance record, not a tracking record \u2014 last_latitude/last_longitude are a single overwritten point with the time it was captured, never a history, and they exist only so a scheduled sweep can decide relevance without the phone being open. last_location_source says WHICH kind of position it was: 'gps' is precise, 'approximate' is IP-derived and may be tens of kilometres out, 'none' means the traveller has not shared one and nothing here may be presented as if they had. A missing row is not 'enabled' \u2014 the layer is off until the traveller turns it on.",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Off by default. Nothing is evaluated or delivered until this is true."
    },
    "min_level": {
      "type": "string",
      "enum": [
        "information",
        "caution",
        "warning",
        "urgent"
      ],
      "default": "caution",
      "description": "The quietest level that may reach them. Information-only items stay in the feed and never notify."
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": true
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "HH:MM in the destination's own clock."
    },
    "quiet_hours_end": {
      "type": "string"
    },
    "quiet_hours_timezone": {
      "type": "string",
      "description": "IANA zone for the destination. Quiet hours are trip-local, never the traveller's home clock."
    },
    "last_latitude": {
      "type": "number"
    },
    "last_longitude": {
      "type": "number"
    },
    "last_location_source": {
      "type": "string",
      "enum": [
        "gps",
        "approximate",
        "none"
      ],
      "default": "none",
      "description": "'approximate' is IP-derived and must be labelled as such wherever a distance is shown from it."
    },
    "last_location_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_evaluated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the sweep last looked at this traveller, so a stalled sweep is visible rather than silent."
    },
    "country": {
      "type": "string",
      "description": "Trip country, used only when no position is available: alerts for the destination generally, always capped at CAUTION."
    }
  },
  "required": [
    "owner_email"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "PinSession",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "user_id": {
      "type": "string"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the session token \u2014 never store plaintext"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_revoked": {
      "type": "boolean",
      "default": false
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "use_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "token_hash",
    "expires_at"
  ]
}
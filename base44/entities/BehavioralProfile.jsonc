{
  "name": "BehavioralProfile",
  "type": "object",
  "properties": {
    "user_email": { "type": "string" },
    "case_id":    { "type": "string" },

    // ── Learning phase ─────────────────────────────────────────────────────
    "learning_phase": {
      "type": "boolean",
      "default": true,
      "description": "True during the first 72h silent observation window"
    },
    "learning_started_at": {
      "type": "string",
      "description": "ISO timestamp — when observation began"
    },

    // ── Behavioral fingerprint ─────────────────────────────────────────────
    // Built during the learning phase. Stored as a JSON object so the
    // schema stays flexible as we add new signals over time.
    "fingerprint": {
      "type": "object",
      "description": "Unique behavioral baseline for this user",
      "default": {}
    },

    // ── Live signals ───────────────────────────────────────────────────────
    "last_signal_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent app activity signal"
    },
    "signals_buffer": {
      "type": "array",
      "description": "Rolling 24h buffer: [{ts, type, hour}] for fingerprint updates",
      "default": []
    },

    // ── Anomaly state ──────────────────────────────────────────────────────
    "anomaly_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 — current deviation from behavioral fingerprint"
    },
    "anomaly_reason": { "type": "string" },
    "context_note":  {
      "type": "string",
      "description": "Human-readable explanation of last analysis result"
    },

    // ── Escalation tracking ────────────────────────────────────────────────
    "status": {
      "type": "string",
      "enum": ["learning", "monitoring", "soft_ping", "check_in_requested", "escalated"],
      "default": "learning"
    },
    "last_nudge_at": { "type": "string" },
    "nudge_count":   { "type": "number", "default": 0 }
  },
  "required": ["user_email"]
}

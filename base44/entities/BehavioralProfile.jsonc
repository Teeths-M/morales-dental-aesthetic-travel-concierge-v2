{
  "name": "BehavioralProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "learning_phase": {
      "type": "boolean",
      "default": true,
      "description": "True during the first 72h silent observation window"
    },
    "learning_started_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 when observation began"
    },
    "fingerprint": {
      "type": "object",
      "description": "Unique behavioral baseline for this user",
      "default": {}
    },
    "last_signal_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent app activity signal"
    },
    "signals_buffer": {
      "type": "array",
      "description": "Rolling 24h buffer: [{ts, type, hour}] for fingerprint updates",
      "default": []
    },
    "anomaly_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 \u2014 current deviation from behavioral fingerprint"
    },
    "anomaly_reason": {
      "type": "string"
    },
    "context_note": {
      "type": "string",
      "description": "Human-readable explanation of last analysis result"
    },
    "status": {
      "type": "string",
      "enum": [
        "learning",
        "monitoring",
        "soft_ping",
        "check_in_requested",
        "escalated"
      ],
      "default": "learning"
    },
    "last_nudge_at": {
      "type": "string"
    },
    "nudge_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
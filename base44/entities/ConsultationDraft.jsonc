{
  "name": "ConsultationDraft",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user who started the consultation"
    },
    "step": {
      "type": "string",
      "description": "Last completed step (e.g., 'personal', 'procedure', 'travel')"
    },
    "form_data": {
      "type": "object",
      "description": "Complete form data saved so far"
    },
    "last_saved_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of last auto-save"
    }
  },
  "required": [
    "user_email",
    "form_data"
  ]
}
{
  "name": "Consultation",
  "type": "object",
  "properties": {
    "patient_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "procedure_interest": {
      "type": "string",
      "enum": [
        "dental_implants",
        "all_on_4",
        "porcelain_veneers",
        "smile_makeover",
        "bone_regeneration",
        "teeth_whitening",
        "rhinoplasty",
        "breast_surgery",
        "liposuction",
        "tummy_tuck",
        "facelift",
        "brow_lift",
        "blepharoplasty",
        "otoplasty",
        "thigh_arm_lift",
        "laser_resurfacing",
        "mole_removal",
        "lipoma_removal",
        "gastric_sleeve",
        "gastric_bypass",
        "gastric_band_revision",
        "gynecological_exams",
        "ivf",
        "egg_freezing",
        "oncology_surgery",
        "tumor_testing",
        "joint_replacement",
        "spine_surgery",
        "sports_arthroscopy",
        "fracture_surgery",
        "other"
      ]
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "description": "Expected return / departure date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled",
        "Travel-Pending",
        "Transfer-Pending",
        "Admin-Review"
      ],
      "default": "pending"
    },
    "journey_stage": {
      "type": "string",
      "enum": [
        "consultation",
        "planning",
        "booking",
        "travel",
        "procedure",
        "recovery",
        "aftercare"
      ],
      "default": "consultation"
    },
    "notes": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "age": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "weight": {
      "type": "string"
    },
    "nationality": {
      "type": "string",
      "description": "Client's country of origin"
    },
    "client_city": {
      "type": "string",
      "description": "Client's city of origin (for chauffeur origin leg routing)"
    },
    "occupation": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_number": {
      "type": "string"
    },
    "has_companion": {
      "type": "boolean"
    },
    "companion_relationship": {
      "type": "string"
    },
    "number_of_companions": {
      "type": "number",
      "default": 0,
      "description": "Number of additional persons travelling with the client"
    },
    "travel_buddy_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_cultural_preferences": {
      "type": "boolean"
    },
    "cultural_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cultural_notes": {
      "type": "string"
    },
    "medical_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "medical_conditions_other": {
      "type": "string"
    },
    "had_surgery": {
      "type": "boolean"
    },
    "previous_procedures": {
      "type": "string"
    },
    "last_surgery_date": {
      "type": "string"
    },
    "had_complications": {
      "type": "boolean"
    },
    "surgery_complications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anesthesia_complications": {
      "type": "boolean"
    },
    "anesthesia_complication_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allergy_details": {
      "type": "string"
    },
    "takes_medications": {
      "type": "boolean"
    },
    "medication_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "medication_notes": {
      "type": "string"
    },
    "lifestyle_habits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exercises_regularly": {
      "type": "boolean"
    },
    "activity_level": {
      "type": "string"
    },
    "emotional_concerns": {
      "type": "boolean"
    },
    "emotional_concern_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emotional_notes": {
      "type": "string"
    },
    "pregnancy_status": {
      "type": "string"
    },
    "document_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uploaded_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_of_stay": {
      "type": "string",
      "description": "e.g. '7 days', '2 weeks'"
    },
    "destination_country": {
      "type": "string",
      "description": "Country where the procedure takes place"
    },
    "client_country": {
      "type": "string",
      "description": "Patient's home country"
    },
    "procedure_country": {
      "type": "string",
      "description": "Country where procedure happens (for chauffeur leg logic)"
    },
    "flight_cost_usd": {
      "type": "number",
      "description": "Flight cost quoted by travel agency (USD)"
    },
    "hotel_cost_usd": {
      "type": "number",
      "description": "Hotel cost quoted by travel agency (USD)"
    },
    "flight_itinerary_summary": {
      "type": "string",
      "description": "e.g. 'Arrives MCO 10:30 AM on 2026-06-15, UA 123 from DEN'"
    },
    "hotel_selection": {
      "type": "string",
      "description": "Hotel name and location chosen by travel agency"
    },
    "transfer_notes": {
      "type": "string",
      "description": "Special instructions for chauffeur (mobility needs, etc.)"
    },
    "leg_1_cost_usd": {
      "type": "number",
      "description": "Origin leg: Client Home \u2192 Local Airport"
    },
    "leg_2_cost_usd": {
      "type": "number",
      "description": "Origin leg: Local Airport \u2192 Client Home (return)"
    },
    "leg_3_cost_usd": {
      "type": "number",
      "description": "Destination leg: Airport \u2192 Hotel (arrival)"
    },
    "leg_4_cost_usd": {
      "type": "number",
      "description": "Destination leg: Hotel \u2192 Clinic"
    },
    "leg_5_cost_usd": {
      "type": "number",
      "description": "Destination leg: Clinic \u2192 Hotel (post-op)"
    },
    "leg_6_cost_usd": {
      "type": "number",
      "description": "Destination leg: Hotel \u2192 Airport (final departure)"
    },
    "travel_agency_id": {
      "type": "string",
      "description": "ID of the assigned travel agency"
    },
    "taxi_service_id": {
      "type": "string",
      "description": "ID of the assigned taxi/chauffeur service"
    },
    "passport_number": {
      "type": "string",
      "description": "Client passport number"
    },
    "passport_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Passport issue date"
    },
    "passport_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Passport expiry date (6-month sentinel rule applied)"
    },
    "ip_country_origin": {
      "type": "string",
      "description": "Auto-detected country from IP geolocation at intake"
    },
    "visa_required_status": {
      "type": "string",
      "enum": [
        "exempt",
        "evisa",
        "embassy",
        "unknown"
      ],
      "default": "unknown",
      "description": "Visa requirement state: exempt | evisa | embassy | unknown"
    }
  },
  "required": [
    "patient_name",
    "email",
    "procedure_interest"
  ],
  "rls": {
    "create": {
      "data.email": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "isAuthenticated": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
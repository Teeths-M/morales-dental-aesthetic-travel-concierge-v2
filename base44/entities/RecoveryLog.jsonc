{
  "name": "RecoveryLog",
  "description": "One daily check-in record per patient per day. Created by the patient via app or SMS. Anomaly detection runs on each new record.",
  "type": "object",
  "properties": {
    "log_id": {
      "type": "string",
      "description": "Short unique ID, e.g. RLG_XXXXXX — generated by checkRecoveryAnomaly"
    },
    "session_id": {
      "type": "string",
      "description": "FK to RecoverySession"
    },
    "trip_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_email": {
      "type": "string",
      "format": "email"
    },
    "date": {
      "type": "string",
      "description": "YYYY-MM-DD — the calendar date this log covers"
    },
    "pain_level": {
      "type": "number",
      "description": "1-10: 1=no pain, 10=severe pain"
    },
    "mobility": {
      "type": "number",
      "description": "1-5: 1=bed-bound, 5=fully mobile"
    },
    "appetite": {
      "type": "number",
      "description": "1-5: 1=cannot eat, 5=normal appetite"
    },
    "wound_status": {
      "type": "string",
      "enum": ["good", "concerning", "bad"],
      "description": "Patient's self-assessment of wound/incision site"
    },
    "notes": {
      "type": "string",
      "description": "Free-text patient notes"
    },
    "submitted_via": {
      "type": "string",
      "enum": ["app", "sms"],
      "default": "app"
    },
    "offline_packet_id": {
      "type": "string",
      "description": "Links to offlineRecoveryQueue entry for reconciliation"
    },
    "anomaly_checked": {
      "type": "boolean",
      "default": false
    },
    "anomaly_severity": {
      "type": "string",
      "enum": ["none", "warning", "escalate"],
      "default": "none"
    },
    "anomaly_reasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Human-readable list of triggered rules"
    }
  },
  "required": ["session_id", "date", "pain_level"],
  "rls": {
    "read": {
      "$or": [
        { "data.patient_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } },
        { "user_condition": { "role": "doctor" } }
      ]
    },
    "create": {
      "user_condition": { "id": "{{user.id}}" }
    },
    "update": {
      "$or": [
        { "data.patient_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  "name": "AccountDeletionRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Self-reported email of the account to delete. NOT verified at submission time — a human confirms identity before actioning via deletePatientData."
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "pending",
      "description": "pending | actioned | dismissed — human admin decides; never auto-applied. 'actioned' means staff ran deletePatientData for this email."
    },
    "source_ip": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "actioned_at": {
      "type": "string",
      "format": "date-time"
    },
    "actioned_by": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "submitted_at"
  ],
  "rls": {
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    },
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "platform_admin" } }
      ]
    }
  }
}

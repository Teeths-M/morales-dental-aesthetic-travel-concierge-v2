{
  "name": "CredentialRecheck",
  "type": "object",
  "description": "A scheduled recurring re-verification of a partner's credential (medical license, IATA code, insurance, accreditation, business registration, identity) against its official primary registry \u2014 with source URL, checked date, expiry/recheck date, and reviewer. The scheduled sweep (runCredentialRecheckSweep) creates these, and expiry/failure suspends NEW bookings for the partner (never auto-cancels existing patient travel or appointments \u2014 those escalate to a human). Distinct from VerifiedCredential (the immutable hash-chained credential mint) \u2014 this is the recurring recheck schedule and its latest live result.",
  "properties": {
    "partner_id": {
      "type": "string"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "doctor",
        "travel_agency",
        "taxi_service",
        "companion",
        "security_agency",
        "hotel",
        "interpreter"
      ]
    },
    "partner_email": {
      "type": "string",
      "format": "email",
      "description": "Denormalized for RLS \u2014 the partner owns their own recheck records."
    },
    "partner_name": {
      "type": "string"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "license",
        "iata_code",
        "insurance",
        "accreditation",
        "business_registration",
        "identity"
      ]
    },
    "credential_reference": {
      "type": "string",
      "description": "The canonical identifier \u2014 license number, IATA code, accreditation id."
    },
    "registry_name": {
      "type": "string"
    },
    "registry_url": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary_registry",
        "vendor",
        "admin_manual",
        "iata_api"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "expired",
        "failed",
        "not_listed",
        "error"
      ],
      "default": "pending"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "next_recheck_date": {
      "type": "string",
      "format": "date"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "raw_result": {
      "type": "object",
      "description": "Sanitized registry result \u2014 { status: 'active', specialty: '...' }. Never raw PII."
    },
    "suspends_new_bookings": {
      "type": "boolean",
      "default": false,
      "description": "True when expiry/failure should gate NEW bookings. Existing patient travel/appointments escalate to a human instead of auto-cancelling."
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "escalation_reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "partner_id",
    "partner_type",
    "partner_email",
    "credential_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
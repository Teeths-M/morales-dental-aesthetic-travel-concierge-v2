{
  "name": "Companion",
  "type": "object",
  "properties": {
    "full_legal_name": {
      "type": "string"
    },
    "age_tier": {
      "type": "string",
      "enum": [
        "40-45",
        "46-50",
        "51-55",
        "55+"
      ]
    },
    "neighborhood": {
      "type": "string",
      "description": "e.g. Pampatar, Porlamar"
    },
    "city": {
      "type": "string",
      "description": "e.g. Margarita Island"
    },
    "culinary_specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Soups, Soft Foods, Diabetic-friendly, Allergy-safe, Traditional local"
    },
    "transit_mobility": {
      "type": "string",
      "enum": [
        "neighborhood_only",
        "city_wide",
        "cook_only"
      ],
      "default": "neighborhood_only"
    },
    "care_comfort_affirmation": {
      "type": "string",
      "enum": [
        "yes",
        "not_sure"
      ],
      "default": "yes",
      "description": "Comfort level with post-surgical patient care"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "reference_1_name": {
      "type": "string"
    },
    "reference_1_phone": {
      "type": "string"
    },
    "reference_2_name": {
      "type": "string"
    },
    "reference_2_phone": {
      "type": "string"
    },
    "medical_nurse_history": {
      "type": "string",
      "description": "Optional background in nursing or healthcare"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_interview",
        "interview_scheduled",
        "verified",
        "rejected"
      ],
      "default": "pending_interview"
    },
    "admin_verification_notes": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "active",
        "inactive",
        "suspended"
      ],
      "default": "pending_verification"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "care_baseline_fee_usd": {
      "type": "number",
      "default": 40,
      "description": "Daily baseline care fee (platform takes 15-20%)"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "whatsapp_pay",
        "stripe"
      ],
      "default": "cash"
    },
    "payout_account": {
      "type": "string"
    },
    "total_assignments": {
      "type": "number",
      "default": 0
    },
    "total_earned_usd": {
      "type": "number",
      "default": 0
    },
    "earnings_this_month": {
      "type": "number",
      "default": 0
    },
    "sign_up_completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "full_legal_name",
    "age_tier",
    "neighborhood",
    "culinary_specialties",
    "transit_mobility",
    "whatsapp_number"
  ]
}
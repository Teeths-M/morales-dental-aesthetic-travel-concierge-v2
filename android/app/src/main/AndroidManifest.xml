<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- navigator.geolocation inside an Android WebView is gated on the app
         holding these. Without them the browser API does not error loudly — it
         reports permission denied — so live tracking, the check-in handshakes
         and the location attached to an SOS would all have failed silently in
         the packaged app while working fine in a mobile browser.
         COARSE is declared alongside FINE because Android 12+ lets the user
         grant approximate location only; an approximate fix is still worth far
         more to a responder than none. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Location is central to the safety layer but must not be required to
         install: a non-traveler using Morales for the vault and emergency
         contacts never needs GPS hardware. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Same silent-failure bug class as the location permissions above:
         navigator.mediaDevices.getUserMedia({audio:true})/MediaRecorder inside
         an Android WebView is gated on the app holding RECORD_AUDIO. Without
         it, voice input (M-Care's mic button, VoiceInputButton.jsx; the
         existing WalkieTalkie translator) would silently fail to get
         microphone access in the packaged app while working fine in a mobile
         browser. Not required to install — every voice feature already falls
         back to typed text when the mic is unavailable or denied. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Same silent-failure bug class as location/microphone above:
         navigator.mediaDevices.getUserMedia({video:...}) inside an Android
         WebView is gated on the app holding CAMERA. Without it, the M-Care
         document scanner (DocumentScannerCard.jsx) and the covert-SOS
         evidence photo (src/lib/covertSosEvidence.js) would silently fail to
         get camera access in the packaged app while working fine in a mobile
         browser. Not required to install — the scanner already offers an
         "Upload" fallback, and a missing photo never blocks or delays a
         covert SOS alert either way. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
